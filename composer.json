{
	"name": "fostercommerce/craft-foster-checkout",
	"description": "A ready-made, best-practices cart and checkout for Craft Commerce.",
	"type": "craft-plugin",
	"license": "proprietary",
	"support": {
		"email": "support@fostercommerce.com",
		"issues": "https://github.com/FosterCommerce/foster-checkout/issues?state=open",
		"source": "https://github.com/FosterCommerce/foster-checkout",
		"docs": "https://www.fostercommerce.com/craft-cms-plugins/foster-checkout/docs",
		"rss": "https://github.com/FosterCommerce/foster-checkout/releases.atom"
	},
	"require": {
		"php": "^8.3",
		"craftcms/cms": "^5.0.0",
		"craftcms/commerce": "^5.0.15"
	},
	"autoload": {
		"psr-4": {
			"fostercommerce\\fostercheckout\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"fostercommerce\\fostercheckout\\tests\\": "tests/"
		}
	},
	"extra": {
		"handle": "foster-checkout",
		"name": "Foster Checkout",
		"developer": "Foster Commerce",
		"documentationUrl": "https://www.fostercommerce.com/craft-cms-plugins/foster-checkout/docs",
		"class": "fostercommerce\\fostercheckout\\FosterCheckout"
	},
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		},
		"allow-plugins": {
			"yiisoft/yii2-composer": true,
			"craftcms/plugin-installer": true
		}
	},
	"require-dev": {
		"craftcms/generator": "^2.1",
		"craftcms/phpstan": "dev-main",
		"craftcms/rector": "dev-main",
		"fostercommerce/advanced-discounts": "^1.1",
		"fostercommerce/ecs": "dev-main",
		"fostercommerce/klaviyoconnect": "^7.2",
		"fostercommerce/rector": "dev-main",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "^12.5",
		"roave/security-advisories": "dev-latest",
		"verbb/gift-voucher": "^4.0"
	},
	"scripts": {
		"phpstan": "phpstan --memory-limit=1G",
		"ecs:check": "ecs check --ansi --memory-limit=1G",
		"ecs:fix": "ecs check --ansi --fix --memory-limit=1G",
		"rector:fix": "rector process --config rector.php",
		"rector:dry-run": "rector process --dry-run --config rector.php",
		"test": "phpunit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration"
	}
}
