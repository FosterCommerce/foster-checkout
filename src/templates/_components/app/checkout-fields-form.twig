{% set positionFields = craft.fostercheckout.checkoutFields('summary', cart) %}

{% if positionFields|length %}
	<div class="mt-8" x-data="AutosaveForm({
		reportsMissing: true,
		savingLabel: {{ 'misc.saving'|t('foster-checkout')|json_encode }},
		savedLabel: {{ 'misc.saved'|t('foster-checkout')|json_encode }},
		failedLabel: {{ 'misc.saveFailed'|t('foster-checkout')|json_encode }},
	})">
		<form
			method="post"
			x-ref="form"
			@submit.prevent="save()"
			@focusout="save()"
			@change="save()"
			@selected="$nextTick(() => save())"
		>
			{{ csrfInput() }}
			{{ actionInput('commerce/cart/update-cart') }}

			{% include 'foster-checkout/_components/app/checkout-fields' with { position: 'summary', showRequired: true } %}
		</form>
		<p class="mt-2 text-sm text-gray-500" role="status" x-text="status"></p>
	</div>
{% endif %}
