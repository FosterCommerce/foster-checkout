{% set address = address ?? null %}
{% set liveId = liveId ?? null %}
{% set sourceAddressId = sourceAddressId ?? null %}
{% if address %}
	{% set fallback = craft.fostercheckout.addressPreview(address, sourceAddressId) %}
	<p>
		{% if liveId %}
			<span class="block" x-text="addressLabel({{ liveId }}, {{ fallback|json_encode }})">{{ fallback }}</span>
		{% else %}
			<span class="block">{{ fallback }}</span>
		{% endif %}
	</p>
{% else %}
	<p>{{ 'misc.noAddress'|t('foster-checkout') }}</p>
{% endif %}
