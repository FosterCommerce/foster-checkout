{% set previewImage = craft.fostercheckout.lineItemImage(lineItem) %}

{% set hasDiscount = lineItem.getDiscount() ? true : false %}
{% set discountNames = lineItem.getAdjustments()|filter(adjustment => adjustment.type == 'discount')|map(adjustment => adjustment.name) %}

{% set lineItemSettings = craft.fostercheckout.settings.lineItems %}
{% set cropsImage = lineItemSettings.imageFit == 'cover' %}

{% set hasImage = true %}
{% set imageUrl = null %}

{% if previewImage|default %}
	{% set imageTransformer = lineItemSettings.imageTransformerInUse() %}
	{# Leave the position out, so Imager X crops around the asset's focal point #}
	{% set imageTransform = {width: 70, height: 70, mode: cropsImage ? 'crop' : 'fit'} %}
	{% if imageTransformer == 'smallpics' %}
		{# Merge the size last, so the params can't override it #}
		{% set imageUrl = craft.smallpics.transformImage(
			previewImage,
			lineItemSettings.imageTransformParams()|merge(imageTransform)
		).url %}
	{% elseif imageTransformer == 'imager-x' %}
		{% set images = craft.imagerx.transformImage(
			previewImage,
			[imageTransform],
			lineItemSettings.imageTransformParams()
		) %}

		{% set imageUrl = images[0].url %}
	{% else %}
		{% set imageUrl = previewImage.getUrl({
			mode: cropsImage ? 'crop' : 'fit',
			position: 'center-center',
			width: 70,
			height: 70,
			quality: 90,
		}) %}
	{% endif %}
{% elseif not lineItemSettings.enablePlaceholderImages %}
	{% set hasImage = false %}
{% endif %}

<article class="flex justify-between items-center gap-4 py-4">
	{% if hasImage %}
		<div class="relative w-[70px] min-w-[70px]">
			<figure class="aspect-square rounded-lg overflow-hidden {{ cropsImage ? '' : 'bg-white' }}">
				{% if imageUrl %}
					<img
						src="{{ imageUrl }}"
						width="70"
						height="70"
						class="w-full h-full {{ cropsImage ? 'object-cover' : 'object-contain' }}"
						alt="{{ 'misc.imageOf'|t('foster-checkout') ~ ' ' ~ lineItem.description }}"
					/>
				{% else %}
					<div class="flex justify-center items-center w-full h-full bg-gray-100 text-gray-300">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/>
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/>
						</svg>
					</div>
				{% endif %}
			</figure>
			{# The figure clips its corners, so the badge sits outside it #}
			<span class="absolute -top-2 -right-2 flex justify-center items-center w-6 h-6 text-xs font-medium text-white bg-[var(--brandColor)] rounded-full">
				<span class="sr-only">{{ 'summary.lineItem.quantity'|t('foster-checkout') }}: </span>{{ lineItem.qty }}
			</span>
		</div>
	{% endif %}

	<div class="flex justify-between items-center gap-4 flex-grow">
		<div class="flex flex-col justify-center items-start gap-1">
			<h3 class="text-sm font-semibold leading-snug hyphens-auto [overflow-wrap:anywhere]">{{ lineItem.description }}</h3>
			{% if not hasImage %}
				<p class="text-sm uppercase text-gray-500">{{ 'summary.lineItem.quantity'|t('foster-checkout') }}: {{ lineItem.qty }}</p>
			{% endif %}
			{% if lineItem.lineItemStatus %}
				<p class="text-sm uppercase text-gray-500">{{ lineItem.lineItemStatus.name|t('foster-checkout') }}</p>
			{% endif %}
		</div>
		<h4 class="text-sm font-semibold text-right leading-snug">
			{% if liveTotals|default %}
				{# Bind what a coupon changes, since the single-page checkout applies one without rendering the page #}
				<span
					class="block text-sm text-[var(--brandColor)] {{ not hasDiscount ? 'hidden' }}"
					:class="{ hidden: !totalsForLineItem({{ lineItem.id }}).hasDiscount }"
					x-text="totalsForLineItem({{ lineItem.id }}).discountNames.join(', ')"
				>{{ discountNames|join(', ') }}</span>
				<span
					class="line-through text-sm text-gray-500 {{ not hasDiscount ? 'hidden' }}"
					:class="{ hidden: !totalsForLineItem({{ lineItem.id }}).hasDiscount }"
					x-text="totalsForLineItem({{ lineItem.id }}).originalTotalAsCurrency"
				>{{ hasDiscount ? craft.fostercheckout.lineItemOriginalTotal(lineItem) }}</span>
				<span x-text="totalsForLineItem({{ lineItem.id }}).priceAsCurrency">{{ hasDiscount ? lineItem.totalAsCurrency : lineItem.subtotalAsCurrency }}</span>
			{% elseif hasDiscount %}
				<span class="block text-sm text-[var(--brandColor)]">{{ discountNames|join(', ') }}</span>
				<span class="line-through text-sm text-gray-500">{{ craft.fostercheckout.lineItemOriginalTotal(lineItem) }}</span> {{ lineItem.totalAsCurrency }}
			{% else %}
				{{ lineItem.subtotalAsCurrency }}
			{% endif %}
		</h4>
	</div>

</article>
