{% if craft.fostercheckout.settings.customerOrderNotesFieldHandle %}
	{% set fieldHandle = craft.fostercheckout.settings.customerOrderNotesFieldHandle %}
	{% set currentValue = cart.getFieldValue(fieldHandle) ?? '' %}

	<div class="mt-8" x-data="AutosaveForm({
		savingLabel: {{ 'misc.saving'|t('foster-checkout')|json_encode }},
		savedLabel: {{ 'misc.saved'|t('foster-checkout')|json_encode }},
		failedLabel: {{ 'misc.saveFailed'|t('foster-checkout')|json_encode }},
	})">
		<p class="mb-2 text-gray-500">{{ 'summary.orderNoteHeading'|t('foster-checkout') }}</p>
		<form method="post" x-ref="form" @submit.prevent="save()" @focusout="save()">
			{{ csrfInput() }}
			{{ actionInput('commerce/cart/update-cart') }}
			<label for="orderNote" class="sr-only">{{ 'summary.addOrderNote'|t('foster-checkout') }}</label>
			<textarea
				id="orderNote"
				name="fields[{{ fieldHandle }}]"
				rows="2"
				class="w-full border border-gray-300 rounded-md px-3 py-2 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
				placeholder="{{ 'summary.addOrderNote'|t('foster-checkout') }}"
			>{{ currentValue }}</textarea>
		</form>
		<p class="mt-2 text-sm text-gray-500" role="status" x-text="status"></p>
	</div>
{% endif %}
