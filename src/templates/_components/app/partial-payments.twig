{% set partialSteps = craft.fostercheckout.partialPayments.steps(cart) %}
{% for step in partialSteps %}
	<section class="my-6" x-data="PartialPaymentControls({{ singlePage|default(false) ? 'true' : 'false' }})">
		<h3 class="mb-4 font-semibold">{{ craft.fostercheckout.gatewayLabel(step.gateway) }}</h3>
		{% if step.applied > 0 %}
			<div class="p-4 bg-gray-200 {{ craft.fostercheckout.settings.branding.style == 'flat' ? '' : 'rounded-lg' }}">
				<p class="text-gray-500">{{ step.appliedLabel|replace({'{amount}': step.applied|currency(cart.currency)}) }}</p>
			</div>
		{% else %}
			<form method="post" @submit.prevent="submitPartialPayment($el)" data-error-message="{{ 'partialPayment.failed'|t('foster-checkout') }}" {% if singlePage|default(false) %}:inert="!canEnterPayment || saving || pending > 0"{% endif %}>
				{{ csrfInput() }}
				{{ actionInput('foster-checkout/partial-payment/apply') }}
				{{ hiddenInput('expectedAmount', step.amount) }}
				{{ hiddenInput('gatewayId', step.gateway.id) }}
				{{ hiddenInput('paymentForm[accountId]', step.accountId) }}
				<fieldset class="grid grid-cols-[1fr,_120px] items-center gap-4" :aria-busy="busy">
					<p class="flex items-center w-full h-12 px-3 bg-white rounded-lg border border-gray-250 text-gray-800">{{ step.label|replace({'{amount}': step.amount|currency(cart.currency)}) }}</p>
					<button type="submit" class="h-12 px-8 text-white bg-[var(--brandColor)] rounded-lg" :disabled="busy" :aria-disabled="busy" :class="busy ? 'opacity-50 cursor-not-allowed' : ''">
						<span x-text="busy ? '{{ 'voucher.applyingCode'|t('foster-checkout')|e('js') }}' : '{{ 'voucher.applyCode'|t('foster-checkout')|e('js') }}'">{{ 'voucher.applyCode'|t('foster-checkout') }}</span>
					</button>
				</fieldset>
			</form>
		{% endif %}
	</section>
{% endfor %}
