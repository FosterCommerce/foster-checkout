<article class="pt-6 border-t {{ craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' ? 'border-gray-300' : 'border-gray-250' }}">

	<dl class="grid grid-cols-1 gap-2">

		<div class="flex justify-between items-center gap-4">
			<dt class="text-gray-500">{{ 'summary.itemsLabel'|t('foster-checkout') }}</dt>
			<dd class="text-right text-black">{{ craft.fostercheckout.itemsTotal(cart) }}</dd>
		</div>

		{% if cart.shippingAddressId or cart.totalShippingCost != 0 %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ 'summary.shippingLabel'|t('foster-checkout') }}</dt>
				<dd class="text-right text-black">{{ cart.totalShippingCostAsCurrency }}</dd>
			</div>
		{% endif %}

		{% for discount in craft.fostercheckout.orderDiscounts(cart) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ discount.name }}</dt>
				<dd class="text-right text-red-500">{{ discount.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		{% for row in craft.fostercheckout.otherAdjustments(cart) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ row.name }}</dt>
				<dd class="text-right text-black">{{ row.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		<div class="flex justify-between items-center gap-4">
			{% if estimated ?? true %}
				<dt class="text-gray-500">{{ 'summary.estimatedTaxLabel'|t('foster-checkout') }}</dt>
			{% else %}
				<dt class="text-gray-500">{{ 'summary.taxLabel'|t('foster-checkout') }}</dt>
			{% endif %}
			<dd class="text-right text-black">{{ cart.totalTaxAsCurrency }}</dd>
		</div>

		{% for row in craft.fostercheckout.afterTaxDiscounts(cart) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ row.name }}</dt>
				<dd class="text-right text-red-500">{{ row.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		{% if craft.app.plugins.isPluginEnabled('gift-voucher') %}

			{% set voucherAdjustments = cart.adjustments|filter(adjustment => adjustment.type == 'voucher') %}

			{% for adj in voucherAdjustments %}
				<div class="flex justify-between items-center gap-4">
					<dt class="text-gray-500">{{ craft.fostercheckout.voucherLabel(adj) }}</dt>
					<dd class="text-right text-red-500">
						<form method="post" class="inline">
							{{ csrfInput() }}
							{{ actionInput('gift-voucher/cart/remove-code') }}
							{{ hiddenInput('voucherCode', craft.fostercheckout.voucherCode(adj)) }}
							<button type="submit" class="mr-2 text-sm underline text-gray-500">{{ 'summary.removeCoupon'|t('foster-checkout') }}</button>
						</form>
						<span>{{ adj.amountAsCurrency }}</span>
					</dd>
				</div>
			{% endfor %}

		{% endif %}

		{% for payment in craft.fostercheckout.partialPayments.steps(cart)|filter(payment => payment.applied > 0) %}
			<div x-data="PartialPaymentControls()" class="flex flex-wrap justify-between items-center gap-4">
				<dt class="text-gray-500">{{ payment.summaryLabel }}</dt>
				<dd class="text-right text-red-500">
					<form method="post" class="inline" @submit="$store.partialPayments.busy = true">
						{{ csrfInput() }}
						{{ actionInput('foster-checkout/partial-payment/remove') }}
						{{ hiddenInput('gatewayId', payment.gateway.id) }}
						{{ hiddenInput('transactionId', payment.transactionId) }}
						<button type="submit" :disabled="busy" :aria-disabled="busy" :class="busy ? 'opacity-50 cursor-not-allowed' : ''" class="mr-2 text-sm underline text-gray-500">{{ 'partialPayment.remove'|t('foster-checkout') }}</button>
					</form>
					<span>{{ (-payment.applied)|currency(cart.currency) }}</span>
				</dd>
			</div>
		{% endfor %}

		{% if estimated ?? true %}
			<div class="flex justify-between items-center gap-4">
				<dt class="font-semibold text-black">{{ 'summary.estimatedTotal'|t('foster-checkout') }}</dt>
				<dd class="font-semibold text-right text-black">{{ craft.fostercheckout.partialPayments.remainingAmount(cart)|currency(cart.currency) }}</dd>
			</div>
		{% else %}
			<div class="flex justify-between items-center gap-4">
				<dt class="font-semibold text-black">{{ 'summary.total'|t('foster-checkout') }}</dt>
				<dd class="font-semibold text-right text-black">{{ craft.fostercheckout.partialPayments.remainingAmount(cart)|currency(cart.currency) }}</dd>
			</div>
		{% endif %}
	</dl>

</article>
