<article>

	<h2 class="mb-6 text-xl font-bold text-gray-800 leading-snug">{{ 'summary.title'|t('foster-checkout') }}</h2>

	<dl class="grid grid-cols-1 gap-2">

		<div class="flex justify-between items-center gap-4">
			<dt class="text-gray-500">{{ 'summary.itemsLabel'|t('foster-checkout') }}</dt>
			<dd class="font-semibold text-right text-black">{{ craft.fostercheckout.itemsTotal(order) }}</dd>
		</div>

		<div class="flex justify-between items-center gap-4">
			<dt class="text-gray-500">{{ 'summary.shippingLabel'|t('foster-checkout') }}</dt>
			<dd class="text-right text-black">{{ order.totalShippingCostAsCurrency }}</dd>
		</div>

		{% for discount in craft.fostercheckout.orderDiscounts(order) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ discount.name }}</dt>
				<dd class="text-right text-red-500">{{ discount.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		{% for row in craft.fostercheckout.otherAdjustments(order) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ row.name }}</dt>
				<dd class="text-right text-black">{{ row.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		<div class="flex justify-between items-center gap-4">
			<dt class="text-gray-500">{{ 'summary.taxLabel'|t('foster-checkout') }}</dt>
			<dd class="text-right text-black">{{ order.totalTaxAsCurrency }}</dd>
		</div>

		{% for row in craft.fostercheckout.afterTaxDiscounts(order) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ row.name }}</dt>
				<dd class="text-right text-red-500">{{ row.amountAsCurrency }}</dd>
			</div>
		{% endfor %}

		{% if craft.app.plugins.isPluginEnabled('gift-voucher') %}
			{% set voucherAdjustments = order.adjustments|filter(adjustment => adjustment.type == 'voucher') %}
			{% if voucherAdjustments|length %}
				<hr class="border-t border-gray-300">
				{% for adj in voucherAdjustments %}
					{% set code = craft.fostercheckout.voucherLabel(adj) %}
					<div class="flex justify-between items-center gap-4">
						<dt class="text-gray-500">
							{{ 'summary.discountApplied'|t('foster-checkout') }}
							<span class="block text-xs text-gray-400">{{ code }}</span>
						</dt>
						<dd class="text-right">
							{{ adj.amount|currency }}
						</dd>
					</div>
				{% endfor %}
			{% endif %}
		{% endif %}

		{% set receipt = craft.fostercheckout.receipt(order) %}
		{% for payment in receipt.partialPayments %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ payment.label }}</dt>
				<dd class="text-right">{{ payment.coverage.negative()|money }}</dd>
			</div>
		{% endfor %}
		<div class="flex justify-between items-center gap-4 mt-4 pt-6 border-t border-gray-200">
			<dt class="font-semibold">{{ 'summary.total'|t('foster-checkout') }}</dt>
			<dd class="font-semibold text-right">{{ receipt.customerTotal|money }}</dd>
		</div>

		{# Include an order with no payment yet, so its balance still shows #}
		{% if not receipt.refundedInFull and (receipt.paid.isPositive() or receipt.balance.isPositive()) %}
			<div class="flex justify-between items-center gap-4">
				<dt class="text-gray-500">{{ 'summary.paid'|t('foster-checkout') }}</dt>
				<dd class="text-right">{{ receipt.paid|money }}</dd>
			</div>
			<div class="flex justify-between items-center gap-4">
				<dt class="font-semibold">{{ (receipt.balance.isNegative() ? 'summary.credit' : 'summary.balanceDue')|t('foster-checkout') }}</dt>
				<dd class="font-semibold text-right">{{ receipt.balance.absolute()|money }}</dd>
			</div>
		{% endif %}

	</dl>

</article>
