{% if context|default %}
	{% set fieldId = id|default ? id|namespaceInputId(context) : '' %}
	{% set fieldName = name|default ? name|namespaceInputName(context) : '' %}
{% else %}
	{% set fieldId = id ?? '' %}
	{% set fieldName = name ?? '' %}
{% endif %}

{% set autocomplete = autocomplete ?? false %}
{% set minLength = minLength ?? false %}
{% set maxLength = maxLength ?? false %}
{% set max = max ?? null %}
{% set min = min ?? null %}
{% set step = step ?? null %}

<div
	data-fc-field
	x-data="ClearableInput({
		label: {{ (label|default(''))|json_encode }},
		name: '{{ name|default('') }}',
		value: '{{ value|default('') }}',
		{# These closures resolve against the address form's scope, so only address fields may pass them. #}
		{% if addressScope|default(false) %}
			addressScope: true,
			countryCode: () => countryCode,
			requiredFields: () => requiredFields(),
		{% endif %}
		{% if required is defined %}
			required: {{ required ? 'true' : 'false' }},
		{% endif %}
		type: '{{ type|default('text') }}',
		requiredError: {{ 'misc.required'|t('foster-checkout')|json_encode }},
		invalidEmailError: {{ 'email.invalid'|t('foster-checkout')|json_encode }},
		errors: {{ errors|default([])|json_encode }},
		success: {{ success|default([])|json_encode }}
	})">
	{% set floatingLabel = label|default and not hideLabel|default and craft.fostercheckout.settings.branding.labelStyle|default('floating') == 'floating' %}

	{% if label|default and not floatingLabel %}
		<label for="{{ fieldId }}" class="{{ hideLabel|default ? 'sr-only' : 'block mb-2 font-medium text-gray-500' }}">
			{{ label }}<span x-text="isRequired() ? '*' : ''"></span>
		</label>
	{% endif %}

	<div class="relative">
		<input
			x-model="value"
			x-ref="input"
			id="{{ fieldId }}"
			name="{{ fieldName }}"
			type="{{ type ?? 'text' }}"
			{{ autocomplete ? "autocomplete=#{autocomplete|default('')}" }}
			{{ minLength ? "minlength=#{minLength}" }}
			{{ maxLength ? "maxlength=#{maxLength}" }}
			{{ min is not null ? "min=#{min}" }}
			{{ max is not null ? "max=#{max}" }}
			{{ step is not null ? "step=#{step}" }}
			class="peer w-full h-12 pl-4 pr-12 {{ floatingLabel ? 'pt-5 pb-1.5 leading-5' : '' }} bg-white rounded-lg focus:!ring-0 focus:!outline-none placeholder:text-gray-400 transition-color duration-300 js-clearable"
			:class="{
				'text-red-500 border-red-500 focus:border-red-500': errors.length,
				'text-gray-800 border-green-500 focus:border-green-500': success.length,
				'text-gray-800 border-gray-250 focus:border-black': !errors.length && !success.length
			}"
			placeholder="{{ floatingLabel ? ' ' : placeholder|default('') }}"
			:aria-invalid="errors.length ? true : false"
			aria-errormessage="{{ fieldId }}-error"
			@input="input"
			@focus="focus"
			@blur="blur()"
			{%- if action|default -%}x-init="{{ action }}" {%- endif -%}
			:required="isRequired()"
		/>
		{% if floatingLabel %}
			<label
				for="{{ fieldId }}"
				class="absolute left-4 right-12 top-1.5 truncate text-xs text-gray-500 transition-all duration-150 peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400 peer-focus:top-1.5 peer-focus:text-xs peer-focus:text-gray-500"
			>
				{{ label }}<span x-text="isRequired() ? '*' : ''"></span>
			</label>
		{% endif %}

		<button
			type="button"
			x-ref="button"
			class="absolute inset-y-0 right-0 flex justify-center items-center w-12 h-12 rounded-r-xl transition-opacity duration-300"
			:class="showButton ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'"
			:aria-hidden="!showButton"
			:tabindex="value ? '0' : '-1'"
			@focus="showButton = value ? true : false"
			@blur="showButton = false"
			@click="clear()"
		>
			<span class="sr-only">{{ 'misc.clearField'|t('foster-checkout') }}</span>
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 14 14" class="fill-current"
					 aria-hidden="true">
				<path
					d="M1.22473 13.9682L0.03125 12.7747L5.80625 6.99973L0.03125 1.22473L1.22473 0.03125L6.99973 5.80625L12.7747 0.03125L13.9682 1.22473L8.1932 6.99973L13.9682 12.7747L12.7747 13.9682L6.99973 8.1932L1.22473 13.9682Z"
					fill="black"/>
			</svg>
		</button>
	</div>

	<template x-if="errors.length">
		<p id="{{ fieldId }}-error" class="mt-1 text-sm text-red-500" x-text="errors.join(' ')"></p>
	</template>

	<template x-if="success.length">
		<p class="mt-1 text-sm text-green-500" x-text="success.join(' ')"></p>
	</template>
</div>
