<!DOCTYPE html>
<html lang="{{ craft.app.language }}" dir="{{ craft.app.locale.getOrientation() }}">
<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<meta http-equiv="X-UA-Compatible" content="ie=edge"/>
	<meta name="robots" content="noindex, nofollow"/>

	{% include 'foster-checkout/_components/app/favicon' %}

	{% set cart = cart is not defined ? craft.commerce.carts.cart : cart %}

	{% if cart.lineItems|length == 0 and craft.app.request.getPathInfo() != craft.fostercheckout.settings.paths.cart and craft.app.request.getSegment(-1) != 'order' %}
		{% redirect siteUrl(craft.fostercheckout.settings.paths.cart) %}
	{% endif %}

	{% if craft.app.request.getSegment(-1) == 'order' and craft.app.request.getParam('number') == null %}
		{% redirect siteUrl(craft.fostercheckout.settings.paths.cart) %}
	{% endif %}

	{% if seomatic|default %}
		{% do seomatic.config.renderEnabled(false) %}
	{% endif %}

	{% block head %}
		<title>
			{{ craft.fostercheckout.settings.branding.title ? craft.fostercheckout.settings.branding.title : siteName }}
		</title>
	{% endblock %}

	<link rel="preconnect" href="https://fonts.googleapis.com"/>
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
	<link
		href="https://fonts.googleapis.com/css2?family={{ craft.fostercheckout.settings.branding.font|split(' ')|join('+') }}:wght@300;400;500;600;700&display=swap"
		rel="stylesheet"
	/>

	{# Self-hosted so the payment page loads no unpinned third-party script #}
	<script src="{{ craft.fostercheckout.tailwindBundle }}"></script>
	<script>
		tailwind.config = {
			theme: {
				extend: {
					colors: {
						gray: {
							100: '#F8F8F8',
							200: '#F3F3F3',
							250: '#E5E5E5',
							300: '#C7C8CD',
							400: '#999999',
							500: '#6B7280',
							600: '#585858',
							700: '#4F5155',
							800: '#1F2937'
						}
					},
					{% if craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' %}
					borderRadius: {
						'xs': 0,
						'sm': 0,
						DEFAULT: '0',
						'md': 0,
						'lg': 0,
						'xl': 0,
						'2xl': 0
					}
					{% endif %}
				}
			}
		}
	</script>
	<style>
		[x-cloak] { display: none !important; }

		{% if craft.fostercheckout.settings.options.enablePageTransitions %}
		@view-transition {
			navigation: auto;
		}
		::view-transition-group(root) {
			animation-duration: 0.5s;
		}

		{% endif %}
	</style>
	<style type="text/tailwindcss">
		@layer utilities {
			body {
				font-family: {{ craft.fostercheckout.settings.branding.font }};
			}

			/* Place any additional custom CSS classes here */
			.radio label::before {
				content: '';
				@apply inline-block w-5 h-5 flex-shrink-0 border-2 border-gray-500 rounded-full;
			}

			.radio input[type="radio"]:focus-visible + label::before {
				@apply ring ring-offset-1;
			}

			.radio input[type="radio"]:checked + label::before {
				background: radial-gradient(
					10px circle at center,
					var(--brandColor) 50%,
					white 51%
				);
				@apply border-[var(--brandColor)];
			}

			/* A gateway cannot be chosen until the address is complete, so its dot reads inert */
			.radio-muted input[type="radio"]:checked + label::before {
				background: radial-gradient(
					10px circle at center,
					#9CA3AF 50%,
					white 51%
				);
				@apply border-gray-400;
			}

			.checkbox {
				@apply relative;
			}

			.checkbox label::before {
				content: '';
				@apply relative inline-block w-5 h-5 flex-shrink-0 border-2 border-gray-500 rounded-sm;
			}

			.checkbox input[type="checkbox"]:focus-visible + label::before {
				@apply ring ring-offset-1;
			}

			.checkbox input[type="checkbox"]:checked + label::before {
				background: var(--brandColor);
				transform: scale(0.5);
				@apply border-[var(--brandColor)];
			}

			.checkbox input[type="checkbox"]:checked + label::after {
				content: '';
				@apply absolute left-0 w-5 h-5 border-2 border-[var(--brandColor)] rounded-sm;
			}
		}
	</style>

	{% block includeHead %}
	{% endblock %}
</head>

<body style="--brandColor: {{ craft.fostercheckout.settings.branding.color }}; --headerBgColor: {{ craft.fostercheckout.settings.branding.headerBgColor }};">

<div>

	{% include 'foster-checkout/_components/app/header' %}

	<div class="max-w-[1200px] mx-auto px-4 text-gray-800 bg-white sm:px-6">
		{% block body %}
		{% endblock %}
	</div>

</div>

<script type="text/javascript">
	window.csrfTokenName = "{{ craft.app.config.general.csrfTokenName|e('js') }}";
	window.csrfTokenValue = "{{ craft.app.request.csrfToken|e('js') }}";
</script>

<script src="{{ craft.fostercheckout.jsBundle }}" type="module"></script>

{% block includeBody %}
{% endblock %}
</body>
</html>
