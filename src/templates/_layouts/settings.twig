{% extends "_layouts/cp" %}

{# Shared layout for the plugin's settings pages. Each page sets `selectedItem` to one of
   'appearance' / 'features' / 'general' so the sidebar highlights the current section. #}

{% set settingsNavItems = {
	'appearance': { title: 'nav.appearance'|t('foster-checkout'), url: 'foster-checkout/settings/appearance' },
	'features': { title: 'nav.features'|t('foster-checkout'), url: 'foster-checkout/settings/features' },
	'general': { title: 'nav.general'|t('foster-checkout'), url: 'foster-checkout/settings/general' },
} %}

{% set selectedItem = selectedItem ?? 'appearance' %}

{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.checkout'|t('foster-checkout'), url: url('foster-checkout/settings/appearance') },
] %}

{% block sidebar %}
	<nav>
		<ul>
			{% for handle, item in settingsNavItems %}
				<li>
					<a href="{{ url(item.url) }}"{% if handle == selectedItem %} class="sel"{% endif %}>{{ item.title }}</a>
				</li>
			{% endfor %}
		</ul>
	</nav>
{% endblock %}
