{# `choiceAfterPickup` is the address choice that Ship to an address restores #}
<div class="xl:border xl:border-gray-250 xl:rounded-lg" x-data="{ choiceAfterPickup: {{ choiceAfterPickup|json_encode }} }">
	<div :class="{ 'bg-gray-100': !shippingPickup }">
		<div class="p-4 radio">
			<input
				id="{{ idPrefix }}_ship"
				type="radio"
				class="absolute opacity-0 w-px h-px"
				name="shippingDestination_radio"
				{{ not pickup ? 'checked' }}
				disabled
				:disabled="false"
				:checked="!shippingPickup"
				@change="shippingChoice = choiceAfterPickup"
			>
			<label
				for="{{ idPrefix }}_ship"
				class="flex justify-start items-center gap-4 cursor-pointer"
				:class="{ 'font-medium text-black': !shippingPickup }"
			>
				{{ 'address.shipToAddress'|t('foster-checkout') }}
			</label>
		</div>

		{# Put saved address rows on white, so the selected row's gray shows #}
		<div{% if addressDropdown %} class="px-4 pb-4"{% elseif listsSavedAddresses %} class="bg-white"{% endif %} x-show="!shippingPickup"{{ pickup ? ' x-cloak' }}>
			{{ addressPicker }}
		</div>
	</div>

	<div class="p-4 border-t border-gray-250" :class="{ 'bg-gray-100': shippingPickup }">
		<div class="radio">
			<input
				id="{{ idPrefix }}_pickup"
				type="radio"
				class="absolute opacity-0 w-px h-px"
				name="shippingDestination_radio"
				{{ pickup ? 'checked' }}
				disabled
				:disabled="false"
				:checked="shippingPickup"
				@change="choiceAfterPickup = shippingChoice; shippingChoice = 'pickup'"
			>
			<label for="{{ idPrefix }}_pickup" class="flex justify-start items-center gap-4 cursor-pointer">
				<span class="block">
					<span class="block" :class="{ 'font-medium text-black': shippingPickup }">
						{{ craft.fostercheckout.customerPickupLabel() }}
					</span>
					<span class="block mt-2 text-gray-500">
						{{ craft.fostercheckout.customerPickupPreview(cart) }}
					</span>
				</span>
			</label>
		</div>
	</div>
</div>
