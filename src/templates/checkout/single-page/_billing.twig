{% set shippingSourceId = cart.sourceShippingAddressId ?? null %}

<div
	data-fc-collect
	@input="refreshNewBillingContent()"
>
	<h3 class="mb-4 font-semibold">
		{{ 'billing.stepName'|t('foster-checkout') }}
	</h3>

	<div class="xl:border xl:border-gray-250 xl:rounded-lg">
		<div class="p-4" :class="{ 'bg-gray-100': billingSameAsShipping }">
			<div class="radio">
				<input
					id="sp_billingSameAsShipping"
					type="radio"
					class="absolute opacity-0 w-px h-px"
					name="billingSameAsShipping_radio"
					:checked="billingSameAsShipping"
					@change="billingSameAsShipping = true; useNewBillingAddress = false; billingAddressId = null; editBillingAddressId = 0"
				>
				<label for="sp_billingSameAsShipping" class="flex justify-start items-center gap-4 cursor-pointer">
					<span class="block">
						<span class="block" :class="{ 'font-medium text-black': billingSameAsShipping }">
							{{ 'billing.sameAsShippingAddress'|t('foster-checkout') }}
						</span>
						<span class="block mt-2 text-gray-500">
							<p>
								<span class="block" x-text="shippingPreview || noAddressLabel"></span>
							</p>
						</span>
					</span>
				</label>
			</div>
		</div>

		{% for address in addresses %}
			{% if shippingSourceId is empty or address.id != shippingSourceId %}
				<div class="p-4 border-t" :class="{ 'bg-gray-100': parseInt(billingAddressId) === {{ address.id }} && !billingSameAsShipping }">
					<div class="flex justify-between items-center gap-4 radio">
						<input
							id="sp_bill_addr_{{ address.id }}"
							type="radio"
							class="absolute opacity-0 w-px h-px"
							name="billingAddressId_radio"
							x-model.number="billingAddressId"
							value="{{ address.id }}"
							@change="billingSameAsShipping = false; useNewBillingAddress = false; editBillingAddressId = 0"
						>
						<label
							for="sp_bill_addr_{{ address.id }}"
							class="inline-flex justify-start items-center gap-4 cursor-pointer"
							:class="{ 'font-medium text-black': parseInt(billingAddressId) === {{ address.id }} && !billingSameAsShipping }"
						>
							{% include 'foster-checkout/_components/app/formatted-address' with {
								address: address,
								liveId: address.id,
							} %}
						</label>

						<template x-if="parseInt(billingAddressId) === {{ address.id }} && !billingSameAsShipping">
							<button
								type="button"
								class="text-[var(--brandColor)] underline"
								@click="editExistingAddress = 0; editBillingAddressId = parseInt(editBillingAddressId) === {{ address.id }} ? 0 : {{ address.id }}"
							>
								<template x-if="parseInt(editBillingAddressId) === {{ address.id }}"><span>{{ 'misc.cancel'|t('foster-checkout') }}</span></template>
								<template x-if="parseInt(editBillingAddressId) !== {{ address.id }}"><span>{{ 'misc.edit'|t('foster-checkout') }}</span></template>
							</button>
						</template>
					</div>

					<template x-if="parseInt(editBillingAddressId) === {{ address.id }}">
						<div
							class="pt-8"
							data-fc-address-edit="{{ address.id }}"
							x-init="applyAddressFields({{ address.id }})"
						>
							{% include 'foster-checkout/_components/app/address-fields' with { address: address } %}
							<div class="flex justify-start items-center gap-4 mt-4 pt-4">
								<button
									type="button"
									class="block min-w-[100px] px-4 py-3 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-lg sm:min-w-[140px] md:min-w-[200px]"
									:disabled="pending > 0"
									:class="pending > 0 ? 'opacity-50 cursor-not-allowed' : ''"
									@click="saveAddressBook({{ address.id }})"
								>
									{{ 'misc.save'|t('foster-checkout') }}
								</button>
								<button
									type="button"
									class="block min-w-[100px] px-4 py-3 font-medium text-[var(--brandColor)] text-center bg-white border border-[var(--brandColor)] rounded-lg sm:min-w-[140px] md:min-w-[200px]"
									@click="editBillingAddressId = 0"
								>
									{{ 'misc.cancel'|t('foster-checkout') }}
								</button>
							</div>
						</div>
					</template>
				</div>
			{% endif %}
		{% endfor %}

		<div class="border-t border-gray-250" :class="{ 'bg-gray-100': useNewBillingAddress }">
			<div class="p-4 radio">
				<input
					id="sp_newBillingAddress"
					type="radio"
					class="absolute opacity-0 w-px h-px"
					name="billingAddressId_radio"
					:checked="useNewBillingAddress"
					@change="billingSameAsShipping = false; billingAddressId = null; useNewBillingAddress = true; editBillingAddressId = 0"
				>
				<label
					for="sp_newBillingAddress"
					class="inline-flex justify-start items-center gap-4 cursor-pointer"
					:class="{ 'font-medium text-black': useNewBillingAddress }"
				>
					{{ 'billing.useDifferentBillingAddress'|t('foster-checkout') }}
				</label>
			</div>

			<template x-if="useNewBillingAddress">
				<div class="p-4" data-fc-new-billing x-init="applyDraftAddress('billing')">
					{% include 'foster-checkout/_components/app/address-fields' with {
						context: 'billingAddress',
						address: cart.billingAddress ?? null,
					} %}

					{% if currentUser %}
						<div class="mt-4 checkbox">
							<input
								type="checkbox"
								class="sr-only"
								id="saveBillingAddressOnOrderComplete"
								name="saveBillingAddressOnOrderComplete"
								value="1"
							>
							<label class="inline-flex justify-start items-center gap-4 cursor-pointer font-medium text-gray-500" for="saveBillingAddressOnOrderComplete">
								{{ 'billing.saveToAddressBook'|t('foster-checkout') }}
							</label>
						</div>
					{% endif %}
				</div>
			</template>
		</div>
	</div>

	{% set note = craft.fostercheckout.note('billing', {cart}) %}
	{% if note %}
		<div class="mt-4 text-sm text-gray-500 [&_a]:underline [&_a:hover]:decoration-current">
			{{ note|raw }}
		</div>
	{% endif %}
</div>
