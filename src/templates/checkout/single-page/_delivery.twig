{% set isFlat = craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' %}

<section
	class="border border-gray-250 overflow-hidden {{ isFlat ? 'lg:border lg:border-gray-300' : 'rounded-lg lg:border lg:border-gray-250' }}"
	data-fc-panel="delivery"
>
	<div class="flex items-center gap-3 p-4 bg-gray-200">
		<h2 class="font-semibold">
			{{ 'checkout.delivery'|t('foster-checkout') }}
		</h2>
		<div class="ml-auto">
			{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'delivery' } %}
		</div>
	</div>

	<div
		class="p-4"
		data-fc-collect
		@input="queueSave(400, $event)"
		@change="queueSave(0, $event)"
		@selected="$nextTick(() => queueSave(0, null, {}, 'delivery'))"
	>
		<div class="xl:border xl:border-gray-250 xl:rounded-lg">
			{% if currentUser and addresses|length %}
				{% for address in addresses %}
					<div class="p-4 border-b border-gray-250" :class="{ 'bg-gray-100': parseInt(shippingAddressId) === {{ address.id }} && !useNewAddress }">
						<div class="flex justify-between items-center gap-4 radio">
							<input
								x-model.number="shippingAddressId"
								id="sp_address_{{ address.id }}"
								name="shippingAddressId_radio"
								type="radio"
								class="sr-only"
								value="{{ address.id }}"
								@change="useNewAddress = false; editExistingAddress = 0"
							/>
							<label
								for="sp_address_{{ address.id }}"
								class="inline-flex justify-start items-center gap-4 cursor-pointer"
								:class="{ 'font-medium text-black': parseInt(shippingAddressId) === {{ address.id }} && !useNewAddress }"
							>
								{% include 'foster-checkout/_components/app/formatted-address' with {
									address: address,
									liveId: address.id,
								} %}
							</label>

							<template x-if="parseInt(shippingAddressId) === {{ address.id }} && !useNewAddress">
								<button
									type="button"
									class="text-[var(--brandColor)] underline"
									@click="editBillingAddressId = 0; editExistingAddress = parseInt(editExistingAddress) === {{ address.id }} ? 0 : {{ address.id }}"
								>
									<template x-if="parseInt(editExistingAddress) === {{ address.id }}"><span>{{ 'misc.cancel'|t('foster-checkout') }}</span></template>
									<template x-if="parseInt(editExistingAddress) !== {{ address.id }}"><span>{{ 'misc.edit'|t('foster-checkout') }}</span></template>
								</button>
							</template>
						</div>

						<template x-if="parseInt(editExistingAddress) === {{ address.id }}">
							<div
								class="pt-8"
								data-fc-address-edit="{{ address.id }}"
								x-init="applyAddressFields({{ address.id }})"
							>
								{% include 'foster-checkout/_components/app/address-fields' with { address: address } %}
								<div class="flex justify-start items-center gap-4 mt-4 pt-4">
									<button
										type="button"
										class="block min-w-[100px] px-4 py-3 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-lg sm:min-w-[140px] md:min-w-[200px]"
										:disabled="pending > 0"
										:class="pending > 0 ? 'opacity-50 cursor-not-allowed' : ''"
										@click="saveAddressBook({{ address.id }})"
									>
										{{ 'misc.save'|t('foster-checkout') }}
									</button>
									<button
										type="button"
										class="block min-w-[100px] px-4 py-3 font-medium text-[var(--brandColor)] text-center bg-white border border-[var(--brandColor)] rounded-lg sm:min-w-[140px] md:min-w-[200px]"
										@click="editExistingAddress = 0"
									>
										{{ 'misc.cancel'|t('foster-checkout') }}
									</button>
								</div>
							</div>
						</template>
					</div>
				{% endfor %}

				<div :class="{ 'bg-gray-100': useNewAddress }">
					<div class="p-4 radio">
						<input
							id="sp_address_0"
							name="shippingAddressId_radio"
							type="radio"
							class="sr-only"
							x-model.number="shippingAddressId"
							value="0"
							@change="useNewAddress = true; editExistingAddress = 0"
						/>
						<label
							for="sp_address_0"
							class="inline-flex justify-start items-center gap-4 cursor-pointer"
							:class="{ 'font-medium text-black': useNewAddress }"
						>
							{{ 'address.newAddress'|t('foster-checkout') }}
						</label>
					</div>
				</div>
			{% endif %}

			<template x-if="useNewAddress">
				<div class="p-4" data-fc-new-shipping x-init="applyDraftAddress('shipping')">
					{% set address = null %}
					{% if cart.shippingAddressId is not null and cart.sourceShippingAddressId is null %}
						{% set address = craft.addresses().id(cart.shippingAddressId).one() %}
					{% elseif cart.shippingAddress %}
						{% set address = cart.shippingAddress %}
					{% endif %}

					{% include 'foster-checkout/_components/app/address-fields' with {
						context: 'shippingAddress',
						address: address,
					} %}

					{% if currentUser %}
						<div class="mt-4 checkbox">
							<input
								type="checkbox"
								id="saveShippingAddressOnOrderComplete"
								class="sr-only"
								name="saveShippingAddressOnOrderComplete"
								value="1"
							/>
							<label
								class="inline-flex justify-start items-center gap-4 cursor-pointer font-medium text-gray-500"
								for="saveShippingAddressOnOrderComplete"
							>
								{{ 'address.saveToAddressBook'|t('foster-checkout') }}
							</label>
						</div>
					{% endif %}
				</div>
			</template>
		</div>

		{% set note = craft.fostercheckout.note('address', {cart}) %}
		{% if note %}
			<div class="mt-4 text-sm text-gray-500 [&_a]:underline [&_a:hover]:decoration-current">
				{{ note|raw }}
			</div>
		{% endif %}
	</div>
</section>
