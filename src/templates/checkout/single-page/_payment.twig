{% set isFlat = craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' %}

<section
	class="border border-gray-250 {{ isFlat ? 'lg:border lg:border-gray-300' : 'rounded-lg lg:border lg:border-gray-250' }}"
	data-fc-panel="payment"
>
	<div class="flex items-center gap-3 p-4 bg-gray-200 {{ isFlat ? '' : 'rounded-t-lg' }}">
		<h2 class="font-semibold">
			{{ 'payment.stepName'|t('foster-checkout') }}
		</h2>
		<div class="ml-auto">
			{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'payment' } %}
		</div>
	</div>

	{% include 'foster-checkout/checkout/single-page/_panel-error' with { panel: 'payment' } %}

	<div class="grid grid-cols-1 gap-5 xl:gap-6 p-4">
		{% set note = craft.fostercheckout.note('payment', {cart}) %}
		{% if note %}
			<div class="text-sm text-gray-500 [&_a]:underline [&_a:hover]:decoration-current">
				{{ note|raw }}
			</div>
		{% endif %}

		<template x-if="collectBilling">
			<div>
				{% include 'foster-checkout/checkout/single-page/_billing' %}
			</div>
		</template>

		{% if craft.app.plugins.isPluginEnabled('gift-voucher') %}
			<section>
				<div class="my-2">
					<h3 class="mb-4 font-semibold">
						{{ 'voucher.voucherHeading'|t('foster-checkout') }}
					</h3>

					<div class="grid grid-cols-[1fr,_120px] items-start gap-4">
						<label for="spVoucherCode" class="sr-only">{{ 'voucher.voucherCode'|t('foster-checkout') }}</label>
						<input
							id="spVoucherCode"
							type="text"
							autocomplete="off"
							placeholder="{{ 'voucher.enterCode'|t('foster-checkout') }}"
							class="w-full h-12 px-4 bg-white rounded-lg border border-gray-250 text-gray-800"
							x-model="voucherCode"
							:aria-invalid="voucherError !== ''"
							:aria-describedby="voucherError !== '' ? 'spVoucherCode-error' : null"
							@keydown.enter.prevent="applyVoucher()"
						>
						<button
							type="button"
							:disabled="voucherCode.trim() === '' || applyingVoucher"
							:aria-disabled="voucherCode.trim() === '' || applyingVoucher"
							:class="voucherCode.trim() === '' || applyingVoucher ? 'opacity-50 cursor-not-allowed' : ''"
							class="h-[48px] flex justify-center items-center gap-2 px-4 text-white bg-[var(--brandColor)] rounded-xl"
							@click="applyVoucher()"
						>
							<span x-text="applyingVoucher ? applyingVoucherLabel : '{{ 'voucher.applyCode'|t('foster-checkout')|e('js') }}'">{{ 'voucher.applyCode'|t('foster-checkout') }}</span>
						</button>
					</div>

					<template x-if="voucherError">
						<p id="spVoucherCode-error" class="mt-1 text-sm text-red-500" x-text="voucherError"></p>
					</template>

					<template x-if="totals.vouchers.length">
						<div class="flex flex-col space-y-2 p-4 mt-4 bg-gray-200 {{ isFlat ? '' : 'rounded-lg' }}">
							<p class="text-gray-500 m-0">
								{{ 'voucher.appliedCodesHeading'|t('foster-checkout') }}:
							</p>
							<ul class="text-gray-500 m-0 list-disc">
								<template x-for="voucher in totals.vouchers" :key="voucher.name + voucher.amountAsCurrency">
									<li class="ml-5" x-text="voucher.name + ' (' + voucher.appliedAmountAsCurrency + ')'"></li>
								</template>
							</ul>
						</div>
					</template>
				</div>
			</section>
		{% endif %}

		<section x-show="paymentBlock" x-cloak>
			<h3 class="mb-4 font-semibold">
				{{ 'payment.paymentMethod'|t('foster-checkout') }}
			</h3>
			<p class="text-sm text-gray-500" role="status" x-text="paymentBlock"></p>
		</section>
		<section class="relative" x-show="!paymentBlock" x-cloak>
			<h3 class="mb-4 font-semibold" x-show="!paying">
				{{ 'payment.paymentMethod'|t('foster-checkout') }}
			</h3>

			<p x-show="!canEnterPayment && !paying" x-cloak class="mb-4 text-sm text-gray-500">
				{{ 'checkout.payIncomplete'|t('foster-checkout') }}
				<span x-show="missingRequiredLabels.length" x-text="missingRequiredLabels.join(', ')"></span>
			</p>

			<div
				class="flex flex-col items-center justify-center gap-3 py-16 text-gray-500"
				x-show="paying"
				x-cloak
				role="status"
				aria-live="polite"
			>
				<svg
					class="w-8 h-8 animate-spin shrink-0"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
				</svg>
				<p class="text-sm text-center" x-text="processingMessage"></p>
			</div>

			<div class="relative" x-show="!paying">
				<div
					x-show="!canEnterPayment"
					class="absolute inset-0 z-20 cursor-not-allowed"
					@click.prevent.stop
					@mousedown.prevent.stop
					@pointerdown.prevent.stop
					aria-hidden="true"
				></div>
				<div :class="{ 'opacity-60 pointer-events-none': !canEnterPayment }">
				<form
					method="POST"
					class="grid gap-y-4 gap-x-4"
					id="paymentForm"
					x-ref="paymentForm"
					data-fc-skip-collect
					@submit="onPaySubmit($event)"
				>
					{{ csrfInput() }}
					{{ actionInput('commerce/payments/pay') }}
					{{ redirectInput(siteUrl(craft.fostercheckout.settings.paths.checkout ~ '/order', { number: cart.number, success: 'true' })) }}
					{{ hiddenInput('cancelUrl', siteUrl(craft.fostercheckout.settings.paths.checkout)|hash) }}
					<input type="hidden" name="orderEmail" :value="email">

					<div class="xl:border xl:border-gray-250 xl:rounded-lg xl:[&>div:first-of-type]:rounded-t-[7px] xl:[&>div:last-of-type]:rounded-b-[7px]" x-show="!awaitingGatewayForm">
						{% for gateway in gateways %}
							{% set gatewayClass = className(gateway) %}
							{% set isManualGateway = false %}
							{% set isMollieGateway = false %}
							{% set gatewayNote = craft.fostercheckout.gatewayNote(gateway.handle, {cart}) %}
							{% set availableAtZero = craft.fostercheckout.settings.isAvailableAtZero(gateway) %}
							{% set zeroOnly = gatewayClass == 'craft\\commerce\\gateways\\Manual' and gateway.getOnlyAllowForZeroPriceOrders() %}

								<div
									class="p-4 border-b border-gray-250"
									data-fc-gateway
									data-available-at-zero="{{ availableAtZero ? '1' : '0' }}"
									data-zero-only="{{ zeroOnly ? '1' : '0' }}"
									{# Mark the row, since the Stripe form inside renders after the box's x-show first runs #}
									data-stripe="{{ gatewayClass == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' ? '1' : '0' }}"
									x-show="gatewayFits($el)"
									:class="{ 'bg-gray-100': parseInt(gatewayId) === {{ gateway.id }} }"
								>
									<div
										class="relative flex justify-between items-center gap-4 radio"
										x-show="fittingGatewayRows.length > 1"
										:class="{ 'radio-muted': !canEnterPayment }"
									>
										<input
											id="sp_gateway_{{ gateway.id }}"
											name="gatewayId"
											type="radio"
											class="absolute opacity-0 w-px h-px"
											x-model.number="gatewayId"
											value="{{ gateway.id }}"
											{# Block a change during a Stripe mount, since its pay request posts whichever gateway is checked. Not disabled, since a disabled radio drops out of that request #}
											@click="stripeMountPending && $event.preventDefault()"
										>
										<label for="sp_gateway_{{ gateway.id }}" class="inline-flex justify-start items-center gap-4 cursor-pointer">
											<span class="block">{{ craft.fostercheckout.gatewayLabel(gateway) }}</span>
										</label>
									</div>

									{# Keep the form rendered and hidden, since PayPal's script only initializes on load #}
									{% set isPaypal = gatewayClass == 'craft\\commerce\\paypalcheckout\\gateways\\Gateway' %}
									{# Render Stripe's form until its mount's pay request returns, since that request reads the form #}
									{% set isStripe = gatewayClass == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' %}
									{% if not isPaypal %}<template x-if="parseInt(gatewayId) === {{ gateway.id }}{{ isStripe ? ' || stripeMountPending' }}">{% endif %}
										<div
											{% if isPaypal or isStripe %}x-show="parseInt(gatewayId) === {{ gateway.id }}"{% endif %}
											{% if isPaypal %}x-cloak{% endif %}
											:class="fittingGatewayRows.length === 1 ? '!pt-0' : ''"
											class="pt-8
											[&_form]:grid [&_form]:gap-2
											[&_fieldset]:border [&_fieldset]:border-gray-250 [&_fieldset]:rounded-lg [&_fieldset]:p-4
											[&_fieldset+fieldset]:mt-4
											[&_legend]:px-1 [&_legend]:text-sm [&_legend]:font-medium [&_legend]:text-gray-700
											[&_.grid]:grid [&_.grid]:gap-4
											[&_.grid[data-cols='2']]:grid-cols-1 md:[&_.grid[data-cols='2']]:grid-cols-2
											[&_.item]:space-y-2
											[&_.multitext]:grid [&_.multitext]:gap-3
											[&_.multitextrow]:grid [&_.multitextrow]:gap-3 [&_.multitextrow]:items-start
											[&_.multitext>.multitextrow:first-child]:grid-cols-1
											[&_.multitext>.multitextrow:not(:first-child)]:grid-cols-3
											[&_.multitextrow>*]:min-w-0
											[&_input.text]:block [&_input.text]:w-full
											[&_input.text]:rounded-xl
											[&_input.text]:border [&_input.text]:border-gray-300
											[&_input.text]:px-3 [&_input.text]:py-2
											focus:[&_input.text]:outline-none
											focus:[&_input.text]:ring-2
											focus:[&_input.text]:ring-[var(--brandColor)]
											[&_input.text::placeholder]:text-gray-400
											[&_.errors]:text-sm [&_.errors]:text-red-600 [&_.errors]:mt-1
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:block
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:min-w-[200px]
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:px-4
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:py-3
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:mt-6
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:font-medium
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:text-white
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:text-center
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:bg-[var(--brandColor)]
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:border
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:border-[var(--brandColor)]
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:rounded-xl
											[&_button#paymentForm-authorizeNet-authorizeSubmit]:transition
											hover:[&_button#paymentForm-authorizeNet-authorizeSubmit]:opacity-90
											"
											x-init="
												{% if gatewayClass == 'craft\\commerce\\paypalcheckout\\gateways\\Gateway' %}
													$nextTick(() => initPaypal());
												{% endif %}
												$nextTick(() => {
													syncPayButtons();
													if ($el.querySelector('[id$=authorizeSubmit]')) {
														wrapAuthorizeHandler();
													}
												})
											"
										>
											{% set buttonText = cart.total == 0 ? 'payment.completeOrder'|t('foster-checkout') : 'payment.payButtonText'|t('foster-checkout') ~ ' ' ~ cart.totalAsCurrency %}
											{% set params = {} %}
											{% set payButtonClasses = 'mt-8 justify-between items-center gap-4 w-full px-4 py-3 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-xl lg:inline-block' %}

											{% if gatewayClass == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' %}
												{% set stripeConfig = craft.fostercheckout.getManualGatewayConfig(gateway.handle) %}
												{% set params = {
													order: cart,
													paymentFormType: 'elements',
													appearance: {
														theme: craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' ? 'flat' : 'stripe',
														labels: 'floating',
														variables: {
															colorPrimary: craft.fostercheckout.settings.branding.color ?? '#1F2937',
															borderRadius: craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' ? '0px' : '6px',
															gridColumnSpacing: '24px',
															gridRowSpacing: '24px',
															tabSpacing: '12px',
														}
													},
													submitButtonText: buttonText,
													submitButtonClasses: payButtonClasses,
													elementOptions: {
														layout: {
															type: stripeConfig.layout|default('tabs'),
														},
														wallets: {
															link: (stripeConfig.enableLink ?? true) ? 'auto' : 'never',
														},
													},
												} %}
												{# The key is left out when the list is empty, since an empty array ranks no type #}
												{% if stripeConfig.paymentMethodOrder ?? [] %}
													{% set params = params|merge({
														elementOptions: params.elementOptions|merge({ paymentMethodOrder: stripeConfig.paymentMethodOrder }),
													}) %}
												{% endif %}
												{# Add the billing phone, which Link otherwise asks for again #}
												{% set phoneFieldHandle = craft.fostercheckout.settings.addressPhoneFieldHandle %}
												{% set billingPhone = phoneFieldHandle and cart.billingAddress ? cart.billingAddress.getFieldValue(phoneFieldHandle) : null %}
												{% if billingPhone %}
													{% set params = params|merge({
														elementOptions: params.elementOptions|merge({ defaultValues: { billingDetails: { phone: billingPhone } } }),
													}) %}
												{% endif %}
											{% elseif gatewayClass == 'craft\\commerce\\paypalcheckout\\gateways\\Gateway' %}
												{% set paypalConfig = craft.fostercheckout.getManualGatewayConfig(gateway.handle) %}
												{# Each list is comma joined for the SDK URL's query string #}
												{% set paypalOptions = {
													'disable-funding': (paypalConfig.disableFunding ?? [])|join(','),
													'enable-funding': (paypalConfig.enableFunding ?? [])|join(','),
													'disable-card': (paypalConfig.disableCard ?? [])|join(','),
													locale: paypalConfig.locale ?? '',
													components: paypalConfig.components ?? '',
												} %}
												{# Empty options are dropped, since the gateway sends any key it finds #}
												{% set params = { currency: cart.paymentCurrency }|merge(paypalOptions|filter(paypalOption => paypalOption is not empty)) %}
											{% elseif gatewayClass == 'craft\\commerce\\mollie\\gateways\\Gateway' %}
												{# Read the methods from the live state, which the plugin rebuilds after each save #}
												{% set isMollieGateway = true %}
											{% elseif gatewayClass == 'craft\\commerce\\gateways\\Manual' %}
												{% set isManualGateway = true %}
												{% set manualFields = craft.fostercheckout.gatewayFields(gateway.handle, cart) %}
											{% else %}
												{# Style the pay button of any gateway that reads submitButtonText and submitButtonClasses #}
												{% set params = { order: cart, submitButtonText: buttonText, submitButtonClasses: payButtonClasses } %}
											{% endif %}

											{# Skip the event for Mollie, since building the live state already triggered it #}
											{% if not isMollieGateway %}
												{% set params = craft.fostercheckout.paymentFormParams(cart, gateway, params) %}
											{% endif %}

											{% if gatewayNote|default %}
												<div class="mb-4 text-sm text-gray-500 [&_a]:underline [&_a:hover]:decoration-current">
													{{ gatewayNote|raw }}
												</div>
											{% endif %}

											{% if isManualGateway or isMollieGateway %}
												{% if isManualGateway and manualFields|length %}
													<div class="grid grid-cols-1 gap-y-4 gap-x-4 sm:grid-cols-12">
														{% for field in manualFields %}
															{# The layout stores width as a percentage; the grid is in twelfths #}
															<div class="sm:col-span-{{ (field.width / 100 * 12)|round }}">
																{% include 'foster-checkout/_components/app/checkout-field' with {
																	field: field,
																	value: field.value,
																} %}
															</div>
														{% endfor %}
													</div>
												{% endif %}

												{% if isMollieGateway %}
													{% include 'foster-checkout/_components/app/mollie-payment-methods' with { paymentMethodsExpression: 'molliePaymentMethods[' ~ gateway.id ~ '] ?? []' } %}
												{% endif %}

												<button
													type="submit"
													class="justify-between items-center gap-4 w-full px-4 py-3 mt-6 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-xl lg:inline-block"
													:disabled="!canPay"
													:aria-disabled="!canPay"
													:class="!canPay ? 'opacity-50 cursor-not-allowed' : ''"
													x-text="payButtonLabel"
												></button>
											{% elseif gatewayClass == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' %}
												{% set savedPaymentSources = currentUser and craft.fostercheckout.settings.enableSavedPaymentSources ? craft.fostercheckout.savedPaymentSources(cart, gateway) : null %}
												{% set paymentSources = savedPaymentSources.paymentSources ?? [] %}
												{% set canSavePaymentSource = savedPaymentSources.canSave ?? false %}
												{% set paymentSourceIds = paymentSources|map(paymentSource => paymentSource.id) %}
												{# Preselect the cart's saved source, then the customer's primary one #}
												{% set preferredPaymentSourceId = cart.paymentSourceId in paymentSourceIds ? cart.paymentSourceId : (cart.customer.primaryPaymentSourceId ?? null) %}
												{% set initialPaymentSourceId = preferredPaymentSourceId in paymentSourceIds ? preferredPaymentSourceId : ((paymentSources|first).id ?? 'new') %}

												<div x-data="{ paymentSourceId: '{{ initialPaymentSourceId }}' }">
													{% if paymentSources %}
														{% include 'foster-checkout/_components/app/payment-sources' %}

														<template x-if="paymentSourceId !== 'new'">
															<div>
																<input type="hidden" name="paymentSourceId" :value="paymentSourceId">
																<button
																	type="submit"
																	class="justify-between items-center gap-4 w-full px-4 py-3 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-xl lg:inline-block"
																	:disabled="!canPay"
																	:aria-disabled="!canPay"
																	:class="!canPay ? 'opacity-50 cursor-not-allowed' : ''"
																	x-text="payButtonLabel"
																></button>
															</div>
														</template>
													{% endif %}

													{# Render the gateway form only for a new payment method.
													   Mounting Stripe's form posts the pay action, which would charge a selected saved source. #}
													<template x-if="paymentSourceId === 'new'">
														<div x-init="$nextTick(() => scheduleStripeReinit())">
															{% if canSavePaymentSource %}
																{% include 'foster-checkout/_components/app/save-payment-source-checkbox' %}
															{% endif %}

															{% namespace gateway.handle|commercePaymentFormNamespace %}
																{{ gateway.getPaymentFormHtml(params)|raw }}
															{% endnamespace %}
														</div>
													</template>
												</div>
											{% else %}
												{% namespace gateway.handle|commercePaymentFormNamespace %}
													{{ gateway.getPaymentFormHtml(params)|raw }}
												{% endnamespace %}
											{% endif %}
										</div>
									{% if not isPaypal %}</template>{% endif %}
								</div>
						{% endfor %}
					</div>
				</form>
				</div>
			</div>
		</section>
	</div>
</section>
