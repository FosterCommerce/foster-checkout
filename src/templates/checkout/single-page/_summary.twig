{% set isFlat = craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' %}
{% set notesHandle = craft.fostercheckout.settings.customerOrderNotesFieldHandle %}
{% set notesValue = notesHandle ? (cart.getFieldValue(notesHandle) ?? '') : '' %}

<aside
	class="order-first lg:order-none lg:col-start-2 lg:row-start-1 lg:row-span-2"
	x-data="{ summaryOpen: false }"
>
	{# Stacked on a phone the summary would push the form down, so it opens on demand #}
	<button
		type="button"
		class="lg:hidden flex justify-between items-center gap-4 w-full p-4 bg-white border border-gray-250 {{ isFlat ? '' : 'rounded-lg' }}"
		:aria-expanded="summaryOpen"
		@click="summaryOpen = !summaryOpen"
	>
		<span class="inline-flex items-center gap-2 font-semibold">
			{{ 'summary.title'|t('foster-checkout') }}
			<svg class="h-5 w-5 transition-transform duration-150" :class="summaryOpen ? 'rotate-180' : ''" viewBox="0 0 20 20" fill="none" aria-hidden="true">
				<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 8l4 4 4-4"></path>
			</svg>
		</span>
		<span class="font-semibold" x-text="totals.totalAsCurrency">{{ live.totals.totalAsCurrency ?? '' }}</span>
	</button>

	{% include 'foster-checkout/_components/app/summary-include' with { step: 'single-page' } %}

	<div class="grid grid-cols-1 gap-6 mt-4 lg:mt-0 lg:sticky lg:top-4 lg:p-4 lg:bg-white {{ isFlat ? 'lg:border lg:border-gray-300' : 'lg:rounded-lg lg:border lg:border-gray-250' }}">
		<div class="grid grid-cols-1 gap-4">
			{# The fields take input, so only what a customer reads collapses #}
			<div
				class="grid-cols-1 gap-6"
				:class="summaryOpen ? 'grid' : 'hidden lg:grid'"
			>
				{# Kept for screen readers, since the cart link in the header replaced the visible heading #}
				<h2 class="sr-only">{{ 'summary.itemsTitle'|t('foster-checkout') }}</h2>

				{% include 'foster-checkout/_components/app/summary-items' with { liveTotals: true } %}
			</div>

			{% set summaryFields = craft.fostercheckout.checkoutFields('summary', cart) %}
			{% if summaryFields|length %}
				<div
					data-fc-panel="summary"
					data-fc-collect
					@blur.capture="saveIfValid('summary', $event)"
					@change="saveIfValid('summary', $event)"
					@selected="$nextTick(() => saveIfValid('summary', $event))"
				>
					{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'summary' } %}
					{% include 'foster-checkout/_components/app/checkout-fields' with { position: 'summary', positionFields: summaryFields, showRequired: true, flush: true } %}
				</div>
			{% endif %}

			{% if notesHandle %}
				{% set floatingLabel = craft.fostercheckout.settings.branding.labelStyle|default('floating') == 'floating' %}
				<div data-fc-collect>
					<form
						class="grid gap-2"
						@submit.prevent="saveNotes()"
					>
						{% if not floatingLabel %}
							<label for="spOrderNote" class="block font-medium text-gray-500">{{ 'summary.orderNoteHeading'|t('foster-checkout') }}</label>
						{% endif %}
						<div class="flex flex-col gap-4 md:flex-row md:items-end">
							<div class="relative w-full min-w-0">
								<textarea
									x-ref="orderNote"
									id="spOrderNote"
									name="fields[{{ notesHandle }}]"
									rows="2"
									class="peer block w-full px-3 {{ floatingLabel ? 'pt-7 pb-2 placeholder-shown:pt-3 placeholder-shown:pb-6' : 'py-3' }} text-gray-800 bg-white border rounded-lg resize-none placeholder:text-gray-400 focus:!outline-none focus:!ring-0 transition-colors duration-300"
									:class="notesError ? 'border-red-500 focus:border-red-500' : 'border-gray-250 focus:border-black'"
									placeholder="{{ floatingLabel ? ' ' : 'summary.addOrderNote'|t('foster-checkout') }}"
									@blur="saveNotes()"
								>{{ notesValue }}</textarea>
								{% if floatingLabel %}
									<label for="spOrderNote" class="absolute left-3 right-3 top-1.5 truncate text-xs text-gray-500 pointer-events-none transition-all duration-150 peer-placeholder-shown:top-3 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-400">{{ 'summary.orderNoteHeading'|t('foster-checkout') }}</label>
								{% endif %}
							</div>
							<button
								type="submit"
								x-show="notesButtonVisible"
								x-cloak
								class="h-12 px-4 font-medium text-white text-center bg-[var(--brandColor)] border border-[var(--brandColor)] rounded-lg text-nowrap shrink-0"
								:disabled="pending > 0"
								:class="pending > 0 ? 'opacity-50 cursor-not-allowed' : ''"
							>
								{{ 'summary.saveOrderNote'|t('foster-checkout') }}
							</button>
						</div>
						{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'notes' } %}
						<p
							x-show="notesError"
							x-cloak
							class="text-sm text-red-500"
							x-text="notesError"
						></p>
					</form>
				</div>
			{% endif %}
		</div>

		<div :class="summaryOpen ? 'block' : 'hidden lg:block'">
			<div
				class="border-t {{ isFlat ? 'border-gray-300' : 'border-gray-250' }}"
			>
				<div x-show="couponCode" x-cloak class="flex justify-between items-center gap-4 py-3">
					<p>
						<span class="font-semibold text-gray-800" x-text="couponCode"></span>
						<span class="text-sm text-gray-500" x-show="couponName && couponName !== couponCode" x-text="couponName"></span>
					</p>
					<span class="inline-flex shrink-0 items-center gap-3">
						{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'coupon' } %}
						<button
							type="button"
							class="text-sm underline text-gray-500 hover:no-underline hover:text-gray-700"
							:disabled="pending > 0"
							:class="pending > 0 ? 'opacity-50 cursor-not-allowed' : ''"
							@click="removeCoupon()"
						>
							{{ 'summary.removeCoupon'|t('foster-checkout') }}
						</button>
					</span>
				</div>

				<div x-show="!couponCode" x-cloak>
				<button
					type="button"
					class="flex justify-between items-center w-full py-3"
					@click="couponOpen = !couponOpen"
					:aria-expanded="couponOpen ? 'true' : 'false'"
					aria-controls="spCouponPanel"
				>
					<span id="spCouponCodeLabel" class="inline-flex items-center gap-2 text-gray-500">
						<span>
							{{ 'summary.couponCodeLabel'|t('foster-checkout') }}
						</span>
						{% include 'foster-checkout/checkout/single-page/_panel-status' with { panel: 'coupon' } %}
					</span>
					<template x-if="couponOpen">
						<svg x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="9" viewBox="0 0 14 9" class="fill-current" aria-hidden="true">
							<path d="M6.99972 0.301388L13.3389 6.64054L11.9247 8.05469L6.99972 3.10469L2.07472 8.02969L0.660568 6.61554L6.99972 0.301388Z"/>
						</svg>
					</template>
					<template x-if="!couponOpen">
						<svg x-cloak xmlns="http://www.w3.org/2000/svg" width="14" height="9" viewBox="0 0 14 9" class="fill-current" aria-hidden="true">
							<path d="M7.00028 8.70057L0.661133 2.36142L2.07528 0.947266L7.00028 5.89727L11.9253 0.972268L13.3394 2.38642L7.00028 8.70057Z"/>
						</svg>
					</template>
				</button>

				<div
					id="spCouponPanel"
					x-show="couponOpen"
					x-cloak
					class="pb-3"
					role="group"
					aria-labelledby="spCouponCodeLabel"
				>
					<template x-if="!couponCode">
						<div>
							<div class="grid grid-cols-[1fr,_120px] items-start gap-4">
								<label for="spCouponCode" class="sr-only">{{ 'summary.couponCode'|t('foster-checkout') }}</label>
								<input
									id="spCouponCode"
									type="text"
									autocomplete="off"
									x-model="couponInput"
									@keydown.enter.prevent="applyCoupon()"
									placeholder="{{ 'summary.couponCodePrompt'|t('foster-checkout') }}"
									class="w-full h-12 px-3 bg-white rounded-lg border border-gray-250 text-gray-800"
									:class="couponError ? 'border-red-500' : ''"
								>
								<button
									type="button"
									class="h-[48px] flex justify-center items-center gap-2 px-4 text-white bg-[var(--brandColor)] rounded-lg"
									:disabled="pending > 0"
									:class="pending > 0 ? 'opacity-50 cursor-not-allowed' : ''"
									@click="applyCoupon()"
								>
									{{ 'summary.submitCouponCode'|t('foster-checkout') }}
								</button>
							</div>
							<p
								x-show="couponError"
								x-cloak
								class="mt-2 text-sm text-red-500"
								x-text="couponError"
							></p>
						</div>
					</template>
				</div>
				</div>
			</div>

			<article class="pt-6 border-t {{ craft.fostercheckout.settings.branding.style|default('rounded') == 'flat' ? 'border-gray-300' : 'border-gray-250' }}">
			<dl class="grid grid-cols-1 gap-2">
				<div class="flex justify-between items-center gap-4">
					<dt class="text-gray-500">{{ 'summary.itemsLabel'|t('foster-checkout') }}</dt>
					<dd class="text-right text-black" x-text="totals.itemsAsCurrency">{{ live.totals.itemsAsCurrency ?? '' }}</dd>
				</div>

				<div class="flex justify-between items-center gap-4" x-show="(cartHasShippingAddress && shippable) || totals.shipping != 0" x-cloak>
					<dt class="text-gray-500">{{ 'summary.shippingLabel'|t('foster-checkout') }}</dt>
					<dd
						class="text-right"
						:class="loadingShippingMethods ? 'text-gray-500' : 'text-black'"
						x-text="totals.shippingAsCurrency"
					>{{ live.totals.shippingAsCurrency ?? '' }}</dd>
				</div>

				<template x-for="discount in totals.discounts" :key="discount.name + discount.amountAsCurrency">
					<div class="flex justify-between items-center gap-4">
						<dt class="text-gray-500" x-text="discount.name"></dt>
						<dd class="text-right text-red-500" x-text="discount.amountAsCurrency"></dd>
					</div>
				</template>

				<template x-for="row in (totals.otherAdjustments || [])" :key="row.name">
					<div class="flex justify-between items-center gap-4">
						<dt class="text-gray-500" x-text="row.name"></dt>
						<dd class="text-right text-black" x-text="row.amountAsCurrency"></dd>
					</div>
				</template>

				<div class="flex justify-between items-center gap-4">
					<dt class="text-gray-500">{{ 'summary.taxLabel'|t('foster-checkout') }}</dt>
					<dd
						class="text-right"
						:class="loadingShippingMethods ? 'text-gray-500' : 'text-black'"
						x-text="totals.taxAsCurrency"
					>{{ live.totals.taxAsCurrency ?? '' }}</dd>
				</div>

				<template x-for="row in (totals.afterTaxDiscounts || [])" :key="row.name">
					<div class="flex justify-between items-center gap-4">
						<dt class="text-gray-500" x-text="row.name"></dt>
						<dd class="text-right text-red-500" x-text="row.amountAsCurrency"></dd>
					</div>
				</template>

				{% if craft.app.plugins.isPluginEnabled('gift-voucher') %}
					<template x-for="voucher in totals.vouchers" :key="voucher.name + voucher.amountAsCurrency">
						<div class="flex justify-between items-center gap-4">
							<dt class="text-gray-500" x-text="voucher.name"></dt>
							<dd class="text-right text-red-500">
								<button
									type="button"
									:disabled="removingVoucher !== ''"
									:aria-disabled="removingVoucher !== ''"
									:class="removingVoucher !== '' ? 'opacity-50 cursor-not-allowed' : ''"
									class="mr-2 text-sm underline text-gray-500"
									@click="removeVoucher(voucher.name)"
								>
									{{ 'summary.removeCoupon'|t('foster-checkout') }}
								</button>
								<span x-text="voucher.amountAsCurrency"></span>
							</dd>
						</div>
					</template>

					<template x-if="removeVoucherError">
						<p class="text-sm text-red-500" x-text="removeVoucherError"></p>
					</template>
				{% endif %}

				<template x-for="payment in (totals.partialPayments || [])" :key="payment.transactionId">
					<div x-data="PartialPaymentControls()" class="flex flex-wrap justify-between items-center gap-4">
						<dt class="text-gray-500" x-text="payment.name"></dt>
						<dd class="text-right text-red-500">
							<form method="post" class="inline" @submit.prevent="submitPartialPayment($el)" data-error-message="{{ 'partialPayment.failed'|t('foster-checkout') }}">
								{{ csrfInput() }}
								{{ actionInput('foster-checkout/partial-payment/remove') }}
								<input type="hidden" name="gatewayId" :value="payment.gatewayId">
								<input type="hidden" name="transactionId" :value="payment.transactionId">
								<button type="submit" :disabled="busy" :aria-disabled="busy" :class="busy ? 'opacity-50 cursor-not-allowed' : ''" class="mr-2 text-sm underline text-gray-500">{{ 'partialPayment.remove'|t('foster-checkout') }}</button>
							</form>
							<span x-text="payment.amountAsCurrency"></span>
						</dd>
					</div>
				</template>

				<div class="flex justify-between items-center gap-4">
					<dt class="font-semibold text-black">{{ 'summary.total'|t('foster-checkout') }}</dt>
					<dd
						class="font-semibold text-right"
						:class="loadingShippingMethods ? 'text-gray-500 font-normal' : 'text-black'"
						x-text="totals.totalAsCurrency"
					>{{ live.totals.totalAsCurrency ?? '' }}</dd>
				</div>
			</dl>
			</article>
		</div>

		{% include 'foster-checkout/_components/app/global-checkout-note' %}
	</div>
</aside>
