{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'addresses' %}
{% set title = 'nav.addresses'|t('foster-checkout') %}
{% set docTitle = title %}

{% set adminChangesAllowed = craft.app.config.general.allowAdminChanges %}
{% set readOnly = not adminChangesAllowed %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/addresses') }}
	{{ hiddenInput('section', 'addresses') }}
	{{ csrfInput() }}

	{% set countriesOverridden = 'priorityCountries' in overriddenSettings %}
	{% set countryRows = [] %}
	{% for countryCode in settings.priorityCountries %}
		{% set countryRows = countryRows|merge([{ code: countryCode }]) %}
	{% endfor %}

	{{ forms.editableTableField({
		label: 'settings.addresses.priorityCountries'|t('foster-checkout'),
		instructions: 'settings.addresses.priorityCountriesHelp'|t('foster-checkout'),
		id: 'priority-countries',
		name: 'settings[priorityCountries]',
		cols: {
			code: { heading: 'settings.addresses.countryCode'|t('foster-checkout'), type: 'singleline' },
		},
		rows: countryRows,
		addRowLabel: 'settings.addresses.addCountry'|t('foster-checkout'),
		allowAdd: true,
		allowDelete: true,
		allowReorder: true,
		static: countriesOverridden or not adminChangesAllowed,
		warning: countriesOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'priorityCountries' }),
	}) }}

	{% set hiddenAddressFieldsOverridden = 'hiddenAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.hiddenAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.hiddenAddressFieldsHelp'|t('foster-checkout'),
		id: 'hidden-address-fields',
		name: 'settings[hiddenAddressFields]',
		options: configurableAddressFields,
		values: settings.hiddenAddressFields,
		disabled: hiddenAddressFieldsOverridden or not adminChangesAllowed,
		warning: hiddenAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'hiddenAddressFields' }),
	}) }}

	{% set hiddenBillingAddressFieldsOverridden = 'hiddenBillingAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.hiddenBillingAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.hiddenBillingAddressFieldsHelp'|t('foster-checkout'),
		id: 'hidden-billing-address-fields',
		name: 'settings[hiddenBillingAddressFields]',
		options: configurableAddressFields,
		values: settings.hiddenBillingAddressFields,
		disabled: hiddenBillingAddressFieldsOverridden or not adminChangesAllowed,
		warning: hiddenBillingAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'hiddenBillingAddressFields' }),
	}) }}

	{% set requiredAddressFieldsOverridden = 'requiredAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.requiredAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.requiredAddressFieldsHelp'|t('foster-checkout'),
		id: 'required-address-fields',
		name: 'settings[requiredAddressFields]',
		options: configurableAddressFields,
		values: settings.requiredAddressFields,
		disabled: requiredAddressFieldsOverridden or not adminChangesAllowed,
		warning: requiredAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'requiredAddressFields' }),
	}) }}

	{% set requiredBillingAddressFieldsOverridden = 'requiredBillingAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.requiredBillingAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.requiredBillingAddressFieldsHelp'|t('foster-checkout'),
		id: 'required-billing-address-fields',
		name: 'settings[requiredBillingAddressFields]',
		options: configurableAddressFields,
		values: settings.requiredBillingAddressFields,
		disabled: requiredBillingAddressFieldsOverridden or not adminChangesAllowed,
		warning: requiredBillingAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'requiredBillingAddressFields' }),
	}) }}

	{% set showAddressLine3Overridden = 'showAddressLine3' in overriddenSettings %}

	{{ forms.lightswitchField({
		label: 'settings.addresses.showAddressLine3'|t('foster-checkout'),
		instructions: 'settings.addresses.showAddressLine3Help'|t('foster-checkout'),
		id: 'show-address-line-3',
		name: 'settings[showAddressLine3]',
		on: settings.showAddressLine3,
		disabled: showAddressLine3Overridden or not adminChangesAllowed,
		warning: showAddressLine3Overridden ? 'settings.overridden'|t('foster-checkout', { setting: 'showAddressLine3' }),
	}) }}

	{% set showAddressLabelFieldOverridden = 'showAddressLabelField' in overriddenSettings %}

	{{ forms.lightswitchField({
		label: 'settings.addresses.showAddressLabelField'|t('foster-checkout'),
		instructions: 'settings.addresses.showAddressLabelFieldHelp'|t('foster-checkout'),
		id: 'show-address-label-field',
		name: 'settings[showAddressLabelField]',
		on: settings.showAddressLabelField,
		disabled: showAddressLabelFieldOverridden or not adminChangesAllowed,
		warning: showAddressLabelFieldOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'showAddressLabelField' }),
	}) }}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
