{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'addresses' %}
{% set title = 'nav.addresses'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/addresses') }}
	{{ hiddenInput('section', 'addresses') }}
	{{ csrfInput() }}

	<h2>{{ 'settings.addresses.shippingTitle'|t('foster-checkout') }}</h2>

	{% if 'notShippableProducts' in overriddenSettings %}
		<p class="warning with-icon">{{ 'settings.overridden'|t('foster-checkout', { setting: 'notShippableProducts' }) }}</p>
	{% else %}
		{% set notShippableInput %}
			{% if readOnly %}
				{# The builder posts through this form, so a read-only environment gets the rule count instead #}
				<p class="light">
					{{ '{num, plural, =0{No rules} =1{1 rule} other{# rules}}'|t('app', {
						num: settings.getNotShippableProductsCondition().getConditionRules()|length,
					}) }}
				</p>
			{% else %}
				{{ settings.getNotShippableProductsCondition().getBuilderHtml()|raw }}
			{% endif %}
		{% endset %}

		{{ forms.field({
			label: 'settings.addresses.notShippable'|t('foster-checkout'),
			instructions: 'settings.addresses.notShippableHelp'|t('foster-checkout'),
			id: 'notShippableProducts',
		}, notShippableInput) }}
	{% endif %}

	<hr>

	<h2>{{ 'settings.addresses.countriesTitle'|t('foster-checkout') }}</h2>

	{% set defaultCountryOverridden = 'defaultCountryCode' in overriddenSettings %}
	{% set countryOptions = [{ label: 'settings.addresses.defaultCountryNone'|t('foster-checkout'), value: '' }] %}
	{% for countryCode, countryName in craft.fostercheckout.storeCountries() %}
		{% set countryOptions = countryOptions|merge([{ label: countryName, value: countryCode }]) %}
	{% endfor %}

	{{ forms.selectField({
		label: 'settings.addresses.defaultCountry'|t('foster-checkout'),
		instructions: 'settings.addresses.defaultCountryHelp'|t('foster-checkout'),
		id: 'default-country-code',
		name: 'settings[defaultCountryCode]',
		options: countryOptions,
		value: settings.defaultCountryCode,
		errors: settings.getErrors('defaultCountryCode'),
		disabled: defaultCountryOverridden or readOnly,
		warning: defaultCountryOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'defaultCountryCode' }),
	}) }}

	{% set countriesOverridden = 'priorityCountries' in overriddenSettings %}
	{% set countryRows = [] %}
	{% for countryCode in settings.priorityCountries %}
		{% set countryRows = countryRows|merge([{ code: countryCode }]) %}
	{% endfor %}

	{{ forms.editableTableField({
		label: 'settings.addresses.priorityCountries'|t('foster-checkout'),
		instructions: 'settings.addresses.priorityCountriesHelp'|t('foster-checkout'),
		id: 'priority-countries',
		name: 'settings[priorityCountries]',
		cols: {
			code: { heading: 'settings.addresses.countryCode'|t('foster-checkout'), type: 'singleline' },
		},
		rows: countryRows,
		addRowLabel: 'settings.addresses.addCountry'|t('foster-checkout'),
		allowAdd: true,
		allowDelete: true,
		allowReorder: true,
		static: countriesOverridden or readOnly,
		warning: countriesOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'priorityCountries' }),
	}) }}

	<hr>

	<h2>{{ 'settings.addresses.fieldsTitle'|t('foster-checkout') }}</h2>

	{% set phoneHandleOverridden = 'addressPhoneFieldHandle' in overriddenSettings %}

	{{ forms.textField({
		label: 'settings.addresses.addressPhoneFieldHandle'|t('foster-checkout'),
		instructions: 'settings.addresses.addressPhoneFieldHandleHelp'|t('foster-checkout'),
		id: 'address-phone-field-handle',
		name: 'settings[addressPhoneFieldHandle]',
		value: settings.addressPhoneFieldHandle,
		disabled: phoneHandleOverridden or readOnly,
		warning: phoneHandleOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'addressPhoneFieldHandle' }),
	}) }}

	{% set hiddenAddressFieldsOverridden = 'hiddenAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.hiddenAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.hiddenAddressFieldsHelp'|t('foster-checkout'),
		id: 'hidden-address-fields',
		name: 'settings[hiddenAddressFields]',
		options: configurableAddressFields,
		values: settings.hiddenAddressFields,
		disabled: hiddenAddressFieldsOverridden or readOnly,
		warning: hiddenAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'hiddenAddressFields' }),
	}) }}

	{% set hiddenBillingAddressFieldsOverridden = 'hiddenBillingAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.hiddenBillingAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.hiddenBillingAddressFieldsHelp'|t('foster-checkout'),
		id: 'hidden-billing-address-fields',
		name: 'settings[hiddenBillingAddressFields]',
		options: configurableAddressFields,
		values: settings.hiddenBillingAddressFields,
		disabled: hiddenBillingAddressFieldsOverridden or readOnly,
		warning: hiddenBillingAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'hiddenBillingAddressFields' }),
	}) }}

	{% set requiredAddressFieldsOverridden = 'requiredAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.requiredAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.requiredAddressFieldsHelp'|t('foster-checkout'),
		id: 'required-address-fields',
		name: 'settings[requiredAddressFields]',
		options: configurableAddressFields,
		values: settings.requiredAddressFields,
		disabled: requiredAddressFieldsOverridden or readOnly,
		warning: requiredAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'requiredAddressFields' }),
	}) }}

	{% set requiredBillingAddressFieldsOverridden = 'requiredBillingAddressFields' in overriddenSettings %}

	{{ forms.checkboxGroupField({
		label: 'settings.addresses.requiredBillingAddressFields'|t('foster-checkout'),
		instructions: 'settings.addresses.requiredBillingAddressFieldsHelp'|t('foster-checkout'),
		id: 'required-billing-address-fields',
		name: 'settings[requiredBillingAddressFields]',
		options: configurableAddressFields,
		values: settings.requiredBillingAddressFields,
		disabled: requiredBillingAddressFieldsOverridden or readOnly,
		warning: requiredBillingAddressFieldsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'requiredBillingAddressFields' }),
	}) }}

	{% set showAddressLine3Overridden = 'showAddressLine3' in overriddenSettings %}

	{{ forms.lightswitchField({
		label: 'settings.addresses.showAddressLine3'|t('foster-checkout'),
		instructions: 'settings.addresses.showAddressLine3Help'|t('foster-checkout'),
		id: 'show-address-line-3',
		name: 'settings[showAddressLine3]',
		on: settings.showAddressLine3,
		disabled: showAddressLine3Overridden or readOnly,
		warning: showAddressLine3Overridden ? 'settings.overridden'|t('foster-checkout', { setting: 'showAddressLine3' }),
	}) }}

	<hr>

	<h2>{{ 'settings.addresses.savedTitle'|t('foster-checkout') }}</h2>

	{% set showAddressLabelFieldOverridden = 'showAddressLabelField' in overriddenSettings %}

	{% set savedAddressLimitOverridden = 'savedAddressLimit' in overriddenSettings %}

	{{ forms.textField({
		label: 'settings.addresses.savedAddressLimit'|t('foster-checkout'),
		instructions: 'settings.addresses.savedAddressLimitHelp'|t('foster-checkout'),
		id: 'saved-address-limit',
		name: 'settings[savedAddressLimit]',
		type: 'number',
		min: 0,
		step: 1,
		size: 5,
		value: settings.savedAddressLimit,
		disabled: savedAddressLimitOverridden or readOnly,
		warning: savedAddressLimitOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'savedAddressLimit' }),
	}) }}

	{{ forms.lightswitchField({
		label: 'settings.addresses.showAddressLabelField'|t('foster-checkout'),
		instructions: 'settings.addresses.showAddressLabelFieldHelp'|t('foster-checkout'),
		id: 'show-address-label-field',
		name: 'settings[showAddressLabelField]',
		on: settings.showAddressLabelField,
		disabled: showAddressLabelFieldOverridden or readOnly,
		warning: showAddressLabelFieldOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'showAddressLabelField' }),
	}) }}

	{% set showAddressLabelInPreviewOverridden = 'showAddressLabelInPreview' in overriddenSettings %}

	{{ forms.lightswitchField({
		label: 'settings.addresses.showAddressLabelInPreview'|t('foster-checkout'),
		instructions: 'settings.addresses.showAddressLabelInPreviewHelp'|t('foster-checkout'),
		id: 'show-address-label-in-preview',
		name: 'settings[showAddressLabelInPreview]',
		on: settings.showAddressLabelInPreview,
		disabled: showAddressLabelInPreviewOverridden or readOnly,
		warning: showAddressLabelInPreviewOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'showAddressLabelInPreview' }),
	}) }}

	<hr>

	<h2>{{ 'settings.addresses.verificationTitle'|t('foster-checkout') }}</h2>

	{% set verificationPinned = 'options.enableAddressVerification' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.addresses.enableAddressVerification'|t('foster-checkout'),
		instructions: 'settings.addresses.enableAddressVerificationHelp'|t('foster-checkout'),
		id: 'options-enableAddressVerification',
		name: 'settings[options][enableAddressVerification]',
		on: settings.options.enableAddressVerification,
		disabled: readOnly or verificationPinned,
		warning: verificationPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'options.enableAddressVerification' }),
	}) }}

	{% set lookupPinned = 'addressLookup.enabled' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.addresses.addressLookupEnabled'|t('foster-checkout'),
		instructions: 'settings.addresses.addressLookupEnabledHelp'|t('foster-checkout'),
		id: 'address-lookup-enabled',
		name: 'settings[addressLookup][enabled]',
		on: settings.addressLookup.enabled,
		disabled: readOnly or lookupPinned,
		warning: lookupPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'addressLookup.enabled' }),
	}) }}

	{% set providerPinned = 'addressLookup.provider' in overriddenSettings %}
	{{ forms.selectField({
		label: 'settings.addresses.addressLookupProvider'|t('foster-checkout'),
		instructions: 'settings.addresses.addressLookupProviderHelp'|t('foster-checkout'),
		id: 'address-lookup-provider',
		name: 'settings[addressLookup][provider]',
		value: settings.addressLookup.provider,
		options: [
			{ label: 'Google Places', value: 'google' },
			{ label: 'Loqate', value: 'loqate' },
		],
		disabled: readOnly or providerPinned,
		warning: providerPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'addressLookup.provider' }),
	}) }}

	{% set apiKeyPinned = 'addressLookup.apiKey' in overriddenSettings %}
	{{ forms.autosuggestField({
		label: 'settings.addresses.addressLookupApiKey'|t('foster-checkout'),
		instructions: 'settings.addresses.addressLookupApiKeyHelp'|t('foster-checkout'),
		id: 'address-lookup-api-key',
		name: 'settings[addressLookup][apiKey]',
		value: settings.addressLookup.apiKey,
		suggestEnvVars: true,
		disabled: readOnly or apiKeyPinned,
		warning: apiKeyPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'addressLookup.apiKey' }),
	}) }}

	{% if settings.addressLookup.enabled %}
		<div class="field">
			{# Submits the settings form so the key on screen is the one tested #}
			<button type="button" class="btn formsubmit" data-action="foster-checkout/settings/test-address-lookup">
				{{ 'settings.addresses.addressLookupTest'|t('foster-checkout') }}
			</button>
			<div class="instructions">
				<p>{{ 'settings.addresses.addressLookupTestHelp'|t('foster-checkout') }}</p>
			</div>
		</div>
	{% endif %}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
