{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'appearance' %}
{% set title = 'nav.appearance'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/appearance') }}
	{{ hiddenInput('section', 'appearance') }}
	{{ csrfInput() }}

	{{ forms.colorField({
		label: 'settings.appearance.color'|t('foster-checkout'),
		instructions: 'settings.appearance.colorHelp'|t('foster-checkout'),
		id: 'branding-color',
		name: 'settings[branding][color]',
		value: settings.branding.color,
		disabled: readOnly or 'branding.color' in overriddenSettings,
		warning: 'branding.color' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.color' }),
	}) }}

	{{ forms.colorField({
		label: 'settings.appearance.headerBgColor'|t('foster-checkout'),
		instructions: 'settings.appearance.headerBgColorHelp'|t('foster-checkout'),
		id: 'branding-header-bg-color',
		name: 'settings[branding][headerBgColor]',
		value: settings.branding.headerBgColor,
		disabled: readOnly or 'branding.headerBgColor' in overriddenSettings,
		warning: 'branding.headerBgColor' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.headerBgColor' }),
	}) }}

	{{ forms.textField({
		label: 'settings.appearance.font'|t('foster-checkout'),
		instructions: 'settings.appearance.fontHelp'|t('foster-checkout'),
		id: 'branding-font',
		name: 'settings[branding][font]',
		value: settings.branding.font,
		disabled: readOnly or 'branding.font' in overriddenSettings,
		warning: 'branding.font' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.font' }),
	}) }}

	{{ forms.textField({
		label: 'settings.appearance.logo'|t('foster-checkout'),
		instructions: 'settings.appearance.logoHelp'|t('foster-checkout'),
		id: 'branding-logo',
		name: 'settings[branding][logo]',
		value: settings.branding.logo,
		placeholder: '/assets/images/logo.svg',
		disabled: readOnly or 'branding.logo' in overriddenSettings,
		warning: 'branding.logo' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.logo' }),
	}) }}

	{{ forms.selectField({
		label: 'settings.appearance.style'|t('foster-checkout'),
		instructions: 'settings.appearance.styleHelp'|t('foster-checkout'),
		id: 'branding-style',
		name: 'settings[branding][style]',
		value: settings.branding.style,
		options: [
			{ label: 'settings.appearance.styleRounded'|t('foster-checkout'), value: 'rounded' },
			{ label: 'settings.appearance.styleFlat'|t('foster-checkout'), value: 'flat' },
		],
		disabled: readOnly or 'branding.style' in overriddenSettings,
		warning: 'branding.style' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.style' }),
	}) }}

	{{ forms.selectField({
		label: 'settings.appearance.labelStyle'|t('foster-checkout'),
		instructions: 'settings.appearance.labelStyleHelp'|t('foster-checkout'),
		id: 'branding-labelStyle',
		name: 'settings[branding][labelStyle]',
		value: settings.branding.labelStyle,
		options: [
			{ label: 'settings.appearance.labelStyleFloating'|t('foster-checkout'), value: 'floating' },
			{ label: 'settings.appearance.labelStyleAbove'|t('foster-checkout'), value: 'above' },
		],
		disabled: readOnly or 'branding.labelStyle' in overriddenSettings,
		warning: 'branding.labelStyle' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.labelStyle' }),
	}) }}

	{{ forms.textField({
		label: 'settings.appearance.title'|t('foster-checkout'),
		instructions: 'settings.appearance.titleHelp'|t('foster-checkout'),
		id: 'branding-title',
		name: 'settings[branding][title]',
		value: settings.branding.title,
		disabled: readOnly or 'branding.title' in overriddenSettings,
		warning: 'branding.title' in overriddenSettings ? 'settings.overridden'|t('foster-checkout', { setting: 'branding.title' }),
	}) }}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
