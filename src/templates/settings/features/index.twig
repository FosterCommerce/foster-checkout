{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'features' %}
{% set title = 'nav.features'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/features') }}
	{{ hiddenInput('section', 'features') }}
	{{ csrfInput() }}

	<h2>{{ 'settings.features.newsletterTitle'|t('foster-checkout') }}</h2>

	{% set newsletterPinned = 'options.enableNewsletter' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.enableNewsletter'|t('foster-checkout'),
		instructions: 'settings.features.enableNewsletterHelp'|t('foster-checkout'),
		id: 'options-enableNewsletter',
		name: 'settings[options][enableNewsletter]',
		on: settings.options.enableNewsletter,
		disabled: readOnly or newsletterPinned,
		warning: newsletterPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'options.enableNewsletter' }),
	}) }}

	{% set listIdPinned = 'options.newsletterListId' in overriddenSettings %}
	{{ forms.autosuggestField({
		label: 'settings.features.newsletterListId'|t('foster-checkout'),
		instructions: 'settings.features.newsletterListIdHelp'|t('foster-checkout'),
		id: 'options-newsletter-list-id',
		name: 'settings[options][newsletterListId]',
		value: settings.options.newsletterListId,
		suggestEnvVars: true,
		disabled: readOnly or listIdPinned,
		warning: listIdPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'options.newsletterListId' }),
	}) }}

	<hr>

	<h2>{{ 'settings.features.customerPickupTitle'|t('foster-checkout') }}</h2>

	{% set enableCustomerPickupOverridden = 'enableCustomerPickup' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.enableCustomerPickup'|t('foster-checkout'),
		instructions: 'settings.features.enableCustomerPickupHelp'|t('foster-checkout'),
		id: 'enable-customer-pickup',
		name: 'settings[enableCustomerPickup]',
		on: settings.enableCustomerPickup,
		disabled: enableCustomerPickupOverridden or readOnly,
		warning: enableCustomerPickupOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'enableCustomerPickup' }),
	}) }}

	{% set customerPickupLabelOverridden = 'customerPickupLabel' in overriddenSettings %}
	{{ forms.textField({
		label: 'settings.features.customerPickupLabel'|t('foster-checkout'),
		instructions: 'settings.features.customerPickupLabelHelp'|t('foster-checkout'),
		id: 'customer-pickup-label',
		name: 'settings[customerPickupLabel]',
		value: settings.customerPickupLabel,
		placeholder: 'address.customerPickup'|t('foster-checkout'),
		disabled: customerPickupLabelOverridden or readOnly,
		warning: customerPickupLabelOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'customerPickupLabel' }),
	}) }}

	<hr>

	<h2>{{ 'settings.features.savedPaymentSourcesTitle'|t('foster-checkout') }}</h2>

	{% set enableSavedPaymentSourcesOverridden = 'enableSavedPaymentSources' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.enableSavedPaymentSources'|t('foster-checkout'),
		instructions: 'settings.features.enableSavedPaymentSourcesHelp'|t('foster-checkout'),
		id: 'enable-saved-payment-sources',
		name: 'settings[enableSavedPaymentSources]',
		on: settings.enableSavedPaymentSources,
		disabled: enableSavedPaymentSourcesOverridden or readOnly,
		warning: enableSavedPaymentSourcesOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'enableSavedPaymentSources' }),
	}) }}

	{% set savedPaymentSourceDisplayOverridden = 'savedPaymentSourceDisplay' in overriddenSettings %}

	{{ forms.selectField({
		label: 'settings.features.savedPaymentSourceDisplay'|t('foster-checkout'),
		instructions: 'settings.features.savedPaymentSourceDisplayHelp'|t('foster-checkout'),
		id: 'saved-payment-source-display',
		name: 'settings[savedPaymentSourceDisplay]',
		value: settings.savedPaymentSourceDisplay,
		errors: settings.getErrors('savedPaymentSourceDisplay'),
		options: [
			{ label: 'settings.features.savedPaymentSourceDisplayAddress'|t('foster-checkout'), value: 'address' },
			{ label: 'settings.addresses.savedAddressDisplayList'|t('foster-checkout'), value: 'list' },
			{ label: 'settings.addresses.savedAddressDisplayDropdown'|t('foster-checkout'), value: 'dropdown' },
		],
		disabled: savedPaymentSourceDisplayOverridden or readOnly,
		warning: savedPaymentSourceDisplayOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'savedPaymentSourceDisplay' }),
	}) }}

	<hr>

	<h2>{{ 'settings.features.clearCartTitle'|t('foster-checkout') }}</h2>

	{% set deleteClearedCartsOverridden = 'deleteClearedCarts' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.deleteClearedCarts'|t('foster-checkout'),
		instructions: 'settings.features.deleteClearedCartsHelp'|t('foster-checkout'),
		id: 'delete-cleared-carts',
		name: 'settings[deleteClearedCarts]',
		on: settings.deleteClearedCarts,
		disabled: deleteClearedCartsOverridden or readOnly,
		warning: deleteClearedCartsOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'deleteClearedCarts' }),
	}) }}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
