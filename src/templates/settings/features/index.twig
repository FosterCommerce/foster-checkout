{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'features' %}
{% set title = 'nav.features'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/features') }}
	{{ hiddenInput('section', 'features') }}
	{{ csrfInput() }}

	<h2>{{ 'settings.features.klaviyoTitle'|t('foster-checkout') }}</h2>

	{% set trackingPinned = 'options.enableKlaviyoTracking' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.enableKlaviyoTracking'|t('foster-checkout'),
		instructions: 'settings.features.enableKlaviyoTrackingHelp'|t('foster-checkout'),
		id: 'options-enableKlaviyoTracking',
		name: 'settings[options][enableKlaviyoTracking]',
		on: settings.options.enableKlaviyoTracking,
		disabled: readOnly or trackingPinned,
		warning: trackingPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'options.enableKlaviyoTracking' }),
	}) }}

	{% set klaviyoPinned = 'options.klaviyoListId' in overriddenSettings %}
	{{ forms.textField({
		label: 'settings.features.klaviyoListId'|t('foster-checkout'),
		instructions: 'settings.features.klaviyoListIdHelp'|t('foster-checkout'),
		id: 'options-klaviyo-list-id',
		name: 'settings[options][klaviyoListId]',
		value: settings.options.klaviyoListId,
		disabled: readOnly or klaviyoPinned,
		warning: klaviyoPinned ? 'settings.overridden'|t('foster-checkout', { setting: 'options.klaviyoListId' }),
	}) }}

	<hr>

	<h2>{{ 'settings.features.customerPickupTitle'|t('foster-checkout') }}</h2>

	{% set enableCustomerPickupOverridden = 'enableCustomerPickup' in overriddenSettings %}
	{{ forms.lightswitchField({
		label: 'settings.features.enableCustomerPickup'|t('foster-checkout'),
		instructions: 'settings.features.enableCustomerPickupHelp'|t('foster-checkout'),
		id: 'enable-customer-pickup',
		name: 'settings[enableCustomerPickup]',
		on: settings.enableCustomerPickup,
		disabled: enableCustomerPickupOverridden or readOnly,
		warning: enableCustomerPickupOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'enableCustomerPickup' }),
	}) }}

	{% set customerPickupLabelOverridden = 'customerPickupLabel' in overriddenSettings %}
	{{ forms.textField({
		label: 'settings.features.customerPickupLabel'|t('foster-checkout'),
		instructions: 'settings.features.customerPickupLabelHelp'|t('foster-checkout'),
		id: 'customer-pickup-label',
		name: 'settings[customerPickupLabel]',
		value: settings.customerPickupLabel,
		placeholder: 'address.customerPickup'|t('foster-checkout'),
		disabled: customerPickupLabelOverridden or readOnly,
		warning: customerPickupLabelOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'customerPickupLabel' }),
	}) }}

	<hr>

	<h2>{{ 'settings.features.deliveryDateTitle'|t('foster-checkout') }}</h2>

	{% set deliveryDateNotes = plugin.getContent().get('notes') ?? {} %}

	{{ forms.textField({
		label: 'content.deliveryDateLabel'|t('foster-checkout'),
		instructions: 'content.deliveryDateLabelHelp'|t('foster-checkout'),
		id: 'delivery-date-label',
		value: deliveryDateNotes.deliveryDateLabel ?? '',
		disabled: true,
		warning: 'settings.features.deliveryDateUnused'|t('foster-checkout'),
	}) }}

	{{ forms.textareaField({
		label: 'content.deliveryDateMessage'|t('foster-checkout'),
		instructions: 'content.deliveryDateMessageHelp'|t('foster-checkout'),
		id: 'delivery-date-message',
		value: deliveryDateNotes.deliveryDateMessage ?? '',
		rows: 3,
		disabled: true,
	}) }}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
