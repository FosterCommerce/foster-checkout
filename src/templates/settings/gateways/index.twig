{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedSubnavItem = 'gateways' %}
{% set title = 'nav.gateways'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-settings') }}
	{{ redirectInput('foster-checkout/settings/gateways') }}
	{{ hiddenInput('section', 'gateways') }}
	{{ csrfInput() }}

	<h2>{{ 'settings.gateways.zeroValueTitle'|t('foster-checkout') }}</h2>

	{% set zeroValueOverridden = 'zeroValueGatewayHandles' in overriddenSettings %}
	{% set gatewayOptions = [] %}
	{% for gateway in gateways %}
		{% set gatewayOptions = gatewayOptions|merge([{ label: gateway.name, value: gateway.handle }]) %}
	{% endfor %}

	{{ forms.checkboxGroupField({
		label: 'settings.gateways.zeroValueGateways'|t('foster-checkout'),
		instructions: 'settings.gateways.zeroValueGatewaysHelp'|t('foster-checkout'),
		id: 'zero-value-gateways',
		name: 'settings[zeroValueGatewayHandles]',
		options: gatewayOptions,
		values: settings.zeroValueGatewayHandles,
		disabled: zeroValueOverridden or readOnly,
		warning: zeroValueOverridden ? 'settings.overridden'|t('foster-checkout', { setting: 'zeroValueGatewayHandles' }),
	}) }}

	<hr>

	<h2>{{ 'settings.gateways.gatewaysTitle'|t('foster-checkout') }}</h2>

	<p>{{ 'settings.gateways.intro'|t('foster-checkout') }}</p>

	{% if gateways is empty %}
		<p class="light">{{ 'settings.gateways.none'|t('foster-checkout') }}</p>
	{% else %}
		<table class="data fullwidth">
			<thead>
				<tr>
					<th scope="col">{{ 'settings.gateways.gateway'|t('foster-checkout') }}</th>
					<th scope="col">{{ 'settings.gateways.fields'|t('foster-checkout') }}</th>
				</tr>
			</thead>
			<tbody>
				{% for gateway in gateways %}
					{% set gatewayFields = craft.fostercheckout.gatewayFields(gateway.handle) %}
					<tr>
						<th scope="row" data-title="{{ 'settings.gateways.gateway'|t('foster-checkout') }}">
							<a href="{{ url('foster-checkout/settings/gateways/' ~ gateway.handle) }}">{{ gateway.name }}</a>
							<span class="light code">{{ gateway.handle }}</span>
						</th>
						<td data-title="{{ 'settings.gateways.fields'|t('foster-checkout') }}">
							{%- if gatewayFields|length -%}
								{{ gatewayFields|column('label')|join(', ') }}
							{%- else -%}
								<span class="light">{{ 'settings.gateways.noFields'|t('foster-checkout') }}</span>
							{%- endif -%}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% endif %}
	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
