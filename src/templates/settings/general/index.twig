{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}

{# @var settings \fostercommerce\fostercheckout\models\Settings #}

{% set selectedItem = 'general' %}
{% set title = 'nav.general'|t('foster-checkout') %}
{% set docTitle = title %}

{% set overridden = 'paths' in overriddenSettings %}
{% set readOnly = overridden or not craft.app.config.general.allowAdminChanges %}

{% if overridden %}
	{% set contentNotice = 'settings.overridden'|t('foster-checkout', { section: 'paths' }) %}
{% elseif readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% block content %}
	<form action="" method="post" accept-charset="UTF-8"{% if not readOnly %} data-saveshortcut{% endif %}>
		{{ actionInput('foster-checkout/settings/save-settings') }}
		{{ redirectInput('foster-checkout/settings/general') }}
		{{ hiddenInput('section', 'general') }}
		{{ csrfInput() }}

		{{ forms.textField({
			label: 'settings.general.cart'|t('foster-checkout'),
			instructions: 'settings.general.cartHelp'|t('foster-checkout'),
			id: 'paths-cart',
			name: 'settings[paths][cart]',
			value: settings.paths.cart,
			placeholder: 'cart',
			disabled: readOnly,
		}) }}

		{{ forms.textField({
			label: 'settings.general.checkout'|t('foster-checkout'),
			instructions: 'settings.general.checkoutHelp'|t('foster-checkout'),
			id: 'paths-checkout',
			name: 'settings[paths][checkout]',
			value: settings.paths.checkout,
			placeholder: 'checkout',
			disabled: readOnly,
		}) }}

		{{ forms.textField({
			label: 'settings.general.account'|t('foster-checkout'),
			instructions: 'settings.general.accountHelp'|t('foster-checkout'),
			id: 'paths-account',
			name: 'settings[paths][account]',
			value: settings.paths.account,
			placeholder: 'account',
			disabled: readOnly,
		}) }}

		{{ forms.textField({
			label: 'settings.general.cancel'|t('foster-checkout'),
			instructions: 'settings.general.cancelHelp'|t('foster-checkout'),
			id: 'paths-cancel',
			name: 'settings[paths][cancel]',
			value: settings.paths.cancel,
			placeholder: '/',
			disabled: readOnly,
		}) }}

		{{ forms.lightswitchField({
			label: 'settings.general.useCartTemplate'|t('foster-checkout'),
			instructions: 'settings.general.useCartTemplateHelp'|t('foster-checkout'),
			id: 'paths-use-cart-template',
			name: 'settings[paths][useCartTemplate]',
			on: settings.paths.useCartTemplate,
			disabled: readOnly,
		}) }}

		<hr>

		{# Each of these is its own top-level config key, so each is overridden independently of the paths above. #}
		{% set includesOverridden = 'includes' in overriddenSettings %}
		{% set adminChangesAllowed = craft.app.config.general.allowAdminChanges %}

		{{ forms.textField({
			label: 'settings.general.includesHead'|t('foster-checkout'),
			instructions: 'settings.general.includesHeadHelp'|t('foster-checkout'),
			id: 'includes-head',
			name: 'settings[includes][head]',
			value: settings.includes.head,
			disabled: includesOverridden or not adminChangesAllowed,
			errors: settings.getErrors('includes'),
			warning: includesOverridden ? 'settings.overridden'|t('foster-checkout', { section: 'includes' }),
		}) }}

		{{ forms.textField({
			label: 'settings.general.includesBody'|t('foster-checkout'),
			instructions: 'settings.general.includesBodyHelp'|t('foster-checkout'),
			id: 'includes-body',
			name: 'settings[includes][body]',
			value: settings.includes.body,
			disabled: includesOverridden or not adminChangesAllowed,
		}) }}

		<hr>

		{% set countriesOverridden = 'priorityCountries' in overriddenSettings %}
		{% set countryRows = [] %}
		{% for countryCode in settings.priorityCountries %}
			{% set countryRows = countryRows|merge([{ code: countryCode }]) %}
		{% endfor %}

		{{ forms.editableTableField({
			label: 'settings.general.priorityCountries'|t('foster-checkout'),
			instructions: 'settings.general.priorityCountriesHelp'|t('foster-checkout'),
			id: 'priority-countries',
			name: 'settings[priorityCountries]',
			cols: {
				code: { heading: 'settings.general.countryCode'|t('foster-checkout'), type: 'singleline' },
			},
			rows: countryRows,
			addRowLabel: 'settings.general.addCountry'|t('foster-checkout'),
			allowAdd: true,
			allowDelete: true,
			allowReorder: true,
			static: countriesOverridden or not adminChangesAllowed,
			warning: countriesOverridden ? 'settings.overridden'|t('foster-checkout', { section: 'priorityCountries' }),
		}) }}

		{% set gatewaysOverridden = 'zeroValueGatewayHandles' in overriddenSettings %}
		{% set gatewayOptions = [] %}
		{% for gateway in gateways %}
			{% set gatewayOptions = gatewayOptions|merge([{ label: gateway.name, value: gateway.handle }]) %}
		{% endfor %}

		{{ forms.checkboxGroupField({
			label: 'settings.general.zeroValueGateways'|t('foster-checkout'),
			instructions: 'settings.general.zeroValueGatewaysHelp'|t('foster-checkout'),
			id: 'zero-value-gateways',
			name: 'settings[zeroValueGatewayHandles]',
			options: gatewayOptions,
			values: settings.zeroValueGatewayHandles,
			disabled: gatewaysOverridden or not adminChangesAllowed,
			warning: gatewaysOverridden ? 'settings.overridden'|t('foster-checkout', { section: 'zeroValueGatewayHandles' }),
		}) }}

		<hr>

		{# Its own top-level config key, so it is overridden independently of the paths above. #}
		{% set orderNotesOverridden = 'customerOrderNotesFieldHandle' in overriddenSettings %}

		{{ forms.textField({
			label: 'settings.general.customerOrderNotesFieldHandle'|t('foster-checkout'),
			instructions: 'settings.general.customerOrderNotesFieldHandleHelp'|t('foster-checkout'),
			id: 'customer-order-notes-field-handle',
			name: 'settings[customerOrderNotesFieldHandle]',
			value: settings.customerOrderNotesFieldHandle,
			disabled: orderNotesOverridden or not craft.app.config.general.allowAdminChanges,
			warning: orderNotesOverridden ? 'settings.overridden'|t('foster-checkout', { section: 'customerOrderNotesFieldHandle' }),
		}) }}

		{% set translationOverridden = 'contentTranslationMethod' in overriddenSettings %}

		{{ forms.selectField({
			label: 'settings.general.contentTranslationMethod'|t('foster-checkout'),
			instructions: 'settings.general.contentTranslationMethodHelp'|t('foster-checkout'),
			id: 'content-translation-method',
			name: 'settings[contentTranslationMethod]',
			value: settings.contentTranslationMethod,
			options: [
				{ label: 'settings.general.translationNone'|t('foster-checkout'), value: 'none' },
				{ label: 'settings.general.translationSite'|t('foster-checkout'), value: 'site' },
				{ label: 'settings.general.translationLanguage'|t('foster-checkout'), value: 'language' },
			],
			disabled: translationOverridden or not craft.app.config.general.allowAdminChanges,
			warning: translationOverridden ? 'settings.overridden'|t('foster-checkout', { section: 'contentTranslationMethod' }),
		}) }}

		{% if not readOnly %}
			<div class="buttons">
				<button type="submit" class="btn submit">{{ 'Save'|t('app') }}</button>
			</div>
		{% endif %}
	</form>
{% endblock %}
