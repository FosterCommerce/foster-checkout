{% extends "foster-checkout/_layouts/settings" %}
{% import "_includes/forms" as forms %}
{% do view.registerAssetBundle('fostercommerce\\fostercheckout\\web\\assets\\cp\\CpAsset') %}

{# @var rule \fostercommerce\fostercheckout\models\LineItemOptionRule #}

{% set selectedSubnavItem = 'line-items' %}
{% set title = isNew
	? 'settings.lineItemOptions.newRule'|t('foster-checkout')
	: 'settings.lineItemOptions.editRule'|t('foster-checkout') %}
{% set docTitle = title %}

{% set readOnly = overridden or not craft.app.config.general.allowAdminChanges %}
{% set fullPageForm = not readOnly %}

{% if readOnly %}
	{% set contentNotice = readOnlyNotice() %}
{% endif %}

{% set crumbs = [
	{ label: 'Settings'|t('app'), url: url('settings') },
	{ label: 'Plugins'|t('app'), url: url('settings/plugins') },
	{ label: 'nav.checkout'|t('foster-checkout'), url: url('foster-checkout/settings/appearance') },
	{ label: 'nav.line-items'|t('foster-checkout'), url: url('foster-checkout/settings/line-items') },
] %}

{% block content %}
	{{ actionInput('foster-checkout/settings/save-line-item-option-rule') }}
	{{ redirectInput('foster-checkout/settings/line-items') }}
	{{ hiddenInput('ruleUid', rule.uid) }}
	{{ csrfInput() }}

	{{ forms.field({
		label: 'settings.lineItemOptions.when'|t('foster-checkout'),
		instructions: 'settings.lineItemOptions.whenHelp'|t('foster-checkout'),
	}, rule.condition.getBuilderHtml()) }}

	{{ forms.textField({
		label: 'settings.lineItemOptions.setName'|t('foster-checkout'),
		instructions: 'settings.lineItemOptions.setNameHelp'|t('foster-checkout'),
		id: 'setName',
		name: 'setName',
		value: rule.setName,
		disabled: readOnly,
	}) }}

	{{ forms.textField({
		label: 'settings.lineItemOptions.setValue'|t('foster-checkout'),
		instructions: 'settings.lineItemOptions.setValueHelp'|t('foster-checkout'),
		id: 'setValue',
		name: 'setValue',
		value: rule.setValue,
		disabled: readOnly,
	}) }}

	{% include 'foster-checkout/_includes/plugin-footer' %}

{% endblock %}
